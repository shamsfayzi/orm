    "daisyui": "^4.12.23"
  },
  "scripts": {
    "copy-preline": "copyfiles -u 2 ./node_modules/preline/dist/preline.js ./",
    "copy-apexchart1": "copyfiles -u 2 ./node_modules/apexcharts/dist/apexcharts.css ./",
    "copy-apexchart2": "copyfiles -u 2 ./node_modules/lodash/lodash.min.js ./",
    "copy-apexchart3": "copyfiles -u 2 ./node_modules/preline/dist/helper-apexcharts.js ./",
    "copy-apexchart4": "copyfiles -u 2 ./node_modules/apexcharts/dist/apexcharts.min.js ./",
    "copy-clipboard": "copyfiles -u 2 ./node_modules/clipboard/dist/clipboard.min.js ./",
    "copy-clipboard1": "copyfiles -u 2 ./node_modules/preline/dist/helper-clipboard.js ./",
    "watch": "npx tailwindcss -i input.css -o output.css --watch --minify",
    "build": "npx tailwindcss -i input.css -o output.css --minify"
  }
}