{
  "dependencies": {
    "@preline/collapse": "^2.5.2",
    "@preline/overlay": "^2.5.2",
    "@preline/remove-element": "^2.6.0",
    "@preline/select": "^2.5.2",
    "@preline/tabs": "^2.5.2",
    "apexcharts": "^4.5.0",
    "clipboard": "^2.0.11",
    "jquery": "^3.7.1",
    "lodash": "^4.17.21",
    "preline": "^2.7.0",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
