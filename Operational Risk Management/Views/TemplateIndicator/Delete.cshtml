@model Operational_Risk_Management.Models.Entities.Indicator

@{
    ViewData["Title"] = "Delete Indicator";
}

<h1 class="text-2xl font-semibold mb-4 text-red-600">Delete Indicator</h1>

<h3 class="text-lg mb-4">Are you sure you want to delete this indicator?</h3>

<div class="bg-white shadow overflow-hidden sm:rounded-lg border border-red-300">
    <div class="px-4 py-5 sm:px-6 bg-red-50">
        <h3 class="text-lg leading-6 font-medium text-red-900">Indicator Details</h3>
    </div>
    <div class="border-t border-gray-200">
        <dl>
            <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                <dt class="text-sm font-medium text-gray-500">@Html.DisplayNameFor(model => model.KRIType)</dt>
                <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">@Html.DisplayFor(model => model.KRIType)</dd>
            </div>
            <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                <dt class="text-sm font-medium text-gray-500">@Html.DisplayNameFor(model => model.RfNo)</dt>
                <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">@Html.DisplayFor(model => model.RfNo)</dd>
            </div>
            <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                <dt class="text-sm font-medium text-gray-500">@Html.DisplayNameFor(model => model.Process)</dt>
                <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">@Html.DisplayFor(model => model.Process)</dd>
            </div>
            <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                <dt class="text-sm font-medium text-gray-500">@Html.DisplayNameFor(model => model.RiskArea)</dt>
                <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">@Html.DisplayFor(model => model.RiskArea)</dd>
            </div>
            <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                <dt class="text-sm font-medium text-gray-500">@Html.DisplayNameFor(model => model.IndicatorName)</dt>
                <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">@Html.DisplayFor(model => model.IndicatorName)</dd>
            </div>
             <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                <dt class="text-sm font-medium text-gray-500">@Html.DisplayNameFor(model => model.FrequencyOfReview)</dt>
                <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">@Html.DisplayFor(model => model.FrequencyOfReview)</dd>
            </div>
            <!-- Add other fields as needed -->
        </dl>
    </div>
</div>

<form asp-action="Delete" class="mt-6">
    <input type="hidden" asp-for="Id" />
    <div class="flex items-center justify-end space-x-4">
        <a asp-action="Index" asp-route-templateId="@Model.TemplateId" class="bg-gray-200 hover:bg-gray-300 text-gray-800 font-bold py-2 px-4 rounded">Cancel</a>
        <input type="submit" value="Delete" class="bg-red-600 hover:bg-red-800 text-white font-bold py-2 px-4 rounded cursor-pointer" />
    </div>
</form>