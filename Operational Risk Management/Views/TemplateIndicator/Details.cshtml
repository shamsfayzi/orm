@model Operational_Risk_Management.Models.View_Models.KRIIndicator.VM_IndicatorDetails

@{
    ViewData["Title"] = "Indicator Details";
    var templateId = Model.Indicator.TemplateId;
}

<div class="container mx-auto px-4 py-8">

    <!-- Header Section -->
    <div class="mb-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
            <h1 class="text-3xl font-bold text-gray-900 dark:text-white">Indicator Details</h1>
            <p class="text-sm text-gray-600 dark:text-neutral-400 mt-1">Template Focal Point: @(Model.TemplateFocalPoint ?? "N/A")</p>
        </div>
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-2 w-full sm:w-auto">
            <!-- Indicator Selection Dropdown -->
            <div class="w-full sm:w-64">
                <label for="indicator-select" class="block text-sm font-medium mb-2 dark:text-white">Switch Indicator:</label>
                <select id="indicator-select" name="indicatorId"
                        class="py-2 px-3 pe-9 block w-full border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500 disabled:opacity-50 disabled:pointer-events-none dark:bg-neutral-900 dark:border-neutral-700 dark:text-neutral-400 dark:placeholder-neutral-500 dark:focus:ring-neutral-600"
                        onchange="if (this.value) window.location.href = '/TemplateIndicator/Details/' + this.value;">
                    <option value="">-- Select Another Indicator --</option>
                    @foreach (var sibling in Model.SiblingIndicators.Where(si => si.Id != Model.Indicator.Id))
                    {
                        <option value="@sibling.Id">@sibling.IndicatorName</option>
                    }
                </select>
            </div>

            <!-- Back Button -->
            <a asp-action="Index" asp-route-templateId="@templateId" class="mt-4 sm:mt-0 py-2 px-4 inline-flex items-center gap-x-2 text-sm font-medium rounded-lg border border-gray-200 bg-white text-gray-800 shadow-sm hover:bg-gray-50 disabled:opacity-50 disabled:pointer-events-none dark:bg-neutral-900 dark:border-neutral-700 dark:text-white dark:hover:bg-neutral-800">
                <svg class="flex-shrink-0 size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                Back to List
            </a>
        </div>
    </div>

    <!-- Indicator Details Card -->
    <div class="bg-white dark:bg-neutral-900 border border-gray-200 dark:border-neutral-700 rounded-xl shadow-sm mb-8">
        <div class="p-4 sm:p-7">
            <h3 class="text-lg font-semibold text-gray-800 dark:text-white mb-4">@Model.Indicator.IndicatorName</h3>
            <dl class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-x-6 gap-y-4">
                <div class="sm:col-span-1">
                    <dt class="font-medium text-gray-500 dark:text-neutral-400">KRI Type</dt>
                    <dd class="text-gray-800 dark:text-neutral-200">@Html.DisplayFor(model => model.Indicator.KRIType, "string_value")</dd>
                </div>
                <div class="sm:col-span-1">
                    <dt class="font-medium text-gray-500 dark:text-neutral-400">Reference No</dt>
                    <dd class="text-gray-800 dark:text-neutral-200">@Html.DisplayFor(model => model.Indicator.RfNo, "string_value")</dd>
                </div>
                <div class="sm:col-span-1">
                    <dt class="font-medium text-gray-500 dark:text-neutral-400">Frequency of Review</dt>
                    <dd class="text-gray-800 dark:text-neutral-200">@Html.DisplayFor(model => model.Indicator.FrequencyOfReview, "string_value")</dd>
                </div>
                <div class="sm:col-span-1">
                    <dt class="font-medium text-gray-500 dark:text-neutral-400">Process</dt>
                    <dd class="text-gray-800 dark:text-neutral-200">@(Model.Indicator.Process ?? "N/A")</dd>
                </div>
                <div class="sm:col-span-1">
                    <dt class="font-medium text-gray-500 dark:text-neutral-400">Risk Area</dt>
                    <dd class="text-gray-800 dark:text-neutral-200">@(Model.Indicator.RiskArea ?? "N/A")</dd>
                </div>
                 <div class="sm:col-span-1">
                    <dt class="font-medium text-gray-500 dark:text-neutral-400">Total Process</dt>
                    <dd class="text-gray-800 dark:text-neutral-200">@Model.Indicator.TotalProcess</dd>
                </div>
                <div class="sm:col-span-1">
                    <dt class="font-medium text-gray-500 dark:text-neutral-400">Tolerable Breaches</dt>
                    <dd class="text-gray-800 dark:text-neutral-200">@Model.Indicator.TolerableBreaches</dd>
                </div>
                <div class="sm:col-span-1">
                    <dt class="font-medium text-gray-500 dark:text-neutral-400">Is Active</dt>
                    <dd class="text-gray-800 dark:text-neutral-200">@(Model.Indicator.IsActive ? "Yes" : "No")</dd>
                </div>
                 <div class="sm:col-span-1">
                    <dt class="font-medium text-gray-500 dark:text-neutral-400">Created At</dt>
                    <dd class="text-gray-800 dark:text-neutral-200">@Html.DisplayFor(model => model.Indicator.CreateDate, "datetime_date_value")</dd>
                </div>
                 <div class="sm:col-span-1">
                    <dt class="font-medium text-gray-500 dark:text-neutral-400">Last Updated</dt>
                    <dd class="text-gray-800 dark:text-neutral-200">@Html.DisplayFor(model => model.Indicator.UpdatedAt, "datetime_date_value")</dd>
                </div>
            </dl>
        </div>
    </div>

    <!-- Submissions Section -->
    <div class="bg-white dark:bg-neutral-900 border border-gray-200 dark:border-neutral-700 rounded-xl shadow-sm">
        <div class="px-6 py-4 border-b border-gray-200 dark:border-neutral-700 bg-white dark:bg-neutral-900 rounded-t-xl shadow-sm">
            <div class="px-6 py-4 border-b border-gray-200 dark:border-neutral-700 bg-white dark:bg-neutral-900 rounded-t-xl shadow-sm">
                <div class="flex flex-col gap-4">
                    <h3 class="text-xl font-semibold text-gray-800 dark:text-white">Submissions</h3>

                    <form method="get" asp-action="Details" asp-route-id="@Model.Indicator.Id" class="space-y-4">
                        <!-- First Row: Search, Year, Month -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
                            <input type="search"
                                   name="searchTerm"
                                   value="@Model.SearchTerm"
                                   placeholder="?? Search comments or user..."
                                   class="py-2 px-3 w-full border border-gray-300 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500 dark:bg-neutral-800 dark:border-neutral-700 dark:text-neutral-100 placeholder-gray-400 dark:placeholder-neutral-500" />

                            <select name="year"
                                    asp-for="SelectedYear"
                                    asp-items="Model.YearOptions"
                                    class="py-2 px-3 w-full border border-gray-300 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500 dark:bg-neutral-800 dark:border-neutral-700 dark:text-neutral-100">
                            </select>

                            <select name="month"
                                    asp-for="SelectedMonth"
                                    asp-items="Model.MonthOptions"
                                    class="py-2 px-3 w-full border border-gray-300 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500 dark:bg-neutral-800 dark:border-neutral-700 dark:text-neutral-100">
                            </select>
                        </div>

                        <!-- Second Row: Filter + Reset -->
                        <div class="flex flex-col sm:flex-row gap-3">
                            <button type="submit" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-lg">
                                <i class="fas fa-filter"></i>
                                <span>Filter</span>
                            </button>
                            <a href="@Url.Action("Details", new { id = Model.Indicator.Id })" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-gray-100 hover:bg-gray-200 text-gray-800 font-semibold py-2 px-4 rounded-lg">
                                <i class="fas fa-rotate-left"></i>
                                <span>Reset</span>
                            </a>
                        </div>
                    </form>
                </div>
            </div>




        <div class="p-4 sm:p-7">
            @if (Model.Submissions != null && Model.Submissions.Items.Any())
            {
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200 dark:divide-neutral-700">
                        <thead class="bg-gray-50 dark:bg-neutral-800">
                            <tr>
                                <th scope="col" class="px-6 py-3 text-start text-xs font-medium text-gray-500 uppercase dark:text-neutral-400">Submission Date</th>
                                <th scope="col" class="px-6 py-3 text-start text-xs font-medium text-gray-500 uppercase dark:text-neutral-400">Breaches</th>
                                <th scope="col" class="px-6 py-3 text-start text-xs font-medium text-gray-500 uppercase dark:text-neutral-400">Comment</th>
                                <th scope="col" class="px-6 py-3 text-start text-xs font-medium text-gray-500 uppercase dark:text-neutral-400">Submitted By</th>
                                <th scope="col" class="px-6 py-3 text-end text-xs font-medium text-gray-500 uppercase dark:text-neutral-400">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200 dark:divide-neutral-700">
                            @foreach (var item in Model.Submissions.Items)
                            {
                                <tr>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-800 dark:text-neutral-200">@Html.DisplayFor(_ => item.CreateDate, "datetime_date_value")</td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-800 dark:text-neutral-200">@item.Breaches</td>
                                    <td class="px-6 py-4 whitespace-normal text-sm text-gray-800 dark:text-neutral-200">@Html.Raw(item.Notes?.Length > 100 ? item.Notes.Substring(0, 100) + "..." : item.Notes)</td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-800 dark:text-neutral-200">@item.CreateBy</td>
                                    <td class="px-6 py-4 whitespace-nowrap text-end text-sm font-medium">
                                        <a asp-controller="IndicatorSubmissions" asp-action="Details" asp-route-id="@item.Id" class="inline-flex items-center gap-x-2 text-sm font-semibold rounded-lg border border-transparent text-blue-600 hover:text-blue-800 disabled:opacity-50 disabled:pointer-events-none dark:text-blue-500 dark:hover:text-blue-400">View</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <!-- Pagination -->
                <div class="mt-6">
                    @await Html.PartialAsync("_Pagination", Model.Submissions.Pagination)
                </div>
            }

            else
            {
                <p class="text-center text-gray-500 dark:text-neutral-400 py-4">No submissions found matching your criteria.</p>
            }
        </div>
    </div>

</div>

@section Scripts{
    <script>
        // Optional: Add any client-side script for enhancing filter interactions if needed.
        // For example, auto-submitting the form on dropdown change.
        document.addEventListener('DOMContentLoaded', function () {
            const yearSelect = document.querySelector('select[name="year"]');
            const monthSelect = document.querySelector('select[name="month"]');
            const filterForm = document.querySelector('form[method="get"]');

            if (yearSelect) {
                yearSelect.addEventListener('change', function() {
                    // When year changes, reset month to 'All Months' if you want that behavior
                    // if (monthSelect) monthSelect.value = ''; 
                    filterForm.submit();
                });
            }
            if (monthSelect) {
                monthSelect.addEventListener('change', function() {
                    filterForm.submit();
                });
            }
        });
    </script>
}