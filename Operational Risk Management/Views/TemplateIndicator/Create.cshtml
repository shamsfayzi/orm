@model Operational_Risk_Management.Models.View_Models.KRIIndicator.VM_IndicatorCreate

@{
    ViewData["Title"] = "Create Indicator";
    var templateId = ViewBag.TemplateId ?? Model.TemplateId;
}

<div class="container mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold text-gray-900 dark:text-white">Create New Indicator</h1>
        <a asp-action="ManageIndicators" asp-route-templateId="@templateId" class="py-2 px-4 inline-flex items-center gap-x-2 text-sm font-medium rounded-lg border border-gray-200 bg-white text-gray-800 shadow-sm hover:bg-gray-50 disabled:opacity-50 disabled:pointer-events-none dark:bg-neutral-900 dark:border-neutral-700 dark:text-white dark:hover:bg-neutral-800">
            <svg class="flex-shrink-0 size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            Back to List
        </a>
    </div>

    <div class="bg-white dark:bg-neutral-900 border border-gray-200 dark:border-neutral-700 rounded-xl shadow-sm">
        <div class="p-4 sm:p-7">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 dark:text-red-400 bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-700 rounded-md p-3 mb-6"></div>
                <input type="hidden" asp-for="TemplateId" value="@templateId" />

                <div class="grid grid-cols-1 sm:grid-cols-12 gap-4 sm:gap-6">
                    
                    <div class="sm:col-span-3">
                        @* Label is generated by EditorTemplate based on DisplayName *@
                        @Html.EditorFor(model => model.KRIType)
                    </div>

                    <div class="sm:col-span-3">
                        @Html.EditorFor(model => model.RfNo)
                    </div>

                    <div class="sm:col-span-6">
                            <label for="FrequencyOfReview" class="block font-medium mb-1.5 pl-1 text-sm">
                                Frequency of Review
                                <span class="text-red-400">*</span>

                            </label>
                        <select asp-for="@Model.FrequencyOfReview" id="FrequencyOfReview" name="FrequencyOfReview" class="py-3 px-4 pe-9 block w-full border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500 disabled:opacity-50 disabled:pointer-events-none">
                            <option value="Monthly">Monthly</option>
                            <option value="Quarterly">Quarterly</option>
                            <option value="Annual">Annual</option>

                            </select>
                            @Html.ValidationMessageFor(a => a.FrequencyOfReview)
                    </div>

                    <div class="sm:col-span-12">
                        @Html.EditorFor(model => model.IndicatorName)
                        @* @Html.ValidationMessageFor(model => model.IndicatorName, "", new { @class = "text-xs text-red-600 mt-1.5" }) *@
                    </div>

                    <div class="sm:col-span-6">
                        @Html.EditorFor(model => model.Process)
                    </div>

                    <div class="sm:col-span-6">
                        @Html.EditorFor(model => model.RiskArea)
                        @* @Html.ValidationMessageFor(model => model.RiskArea, "", new { @class = "text-xs text-red-600 mt-1.5" }) *@
                    </div>

                    <div class="sm:col-span-4">
                        @Html.EditorFor(model => model.TotalProcess)
                        @* @Html.ValidationMessageFor(model => model.TotalProcess, "", new { @class = "text-xs text-red-600 mt-1.5" }) *@
                    </div>

                    <div class="sm:col-span-4">
                        @Html.EditorFor(model => model.TolerableBreaches)
                        @* @Html.ValidationMessageFor(model => model.TolerableBreaches, "", new { @class = "text-xs text-red-600 mt-1.5" }) *@
                    </div>

                  
                </div>

                <div class="mt-6 flex justify-end gap-x-2">
                    <a asp-action="ManageIndicators" asp-route-templateId="@templateId" class="py-2 px-3 inline-flex items-center gap-x-2 text-sm font-medium rounded-lg border border-gray-200 bg-white text-gray-800 shadow-sm hover:bg-gray-50 disabled:opacity-50 disabled:pointer-events-none dark:bg-neutral-900 dark:border-neutral-700 dark:text-white dark:hover:bg-neutral-800">
                        Cancel
                    </a>
                    <button type="submit" class="py-2 px-3 inline-flex items-center gap-x-2 text-sm font-semibold rounded-lg border border-transparent bg-blue-600 text-white hover:bg-blue-700 disabled:opacity-50 disabled:pointer-events-none">
                        Create Indicator
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}