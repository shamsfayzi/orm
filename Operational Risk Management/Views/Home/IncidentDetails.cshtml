@using Operational_Risk_Management.Models.View_Models.Incident
@using Operational_Risk_Management.Models.Entities // For IncidentReviewComment if directly used, though DTO is primary here
@model IncidentDetailDTO

@{
    ViewData["Title"] = "Incident Details";
}

<header class="bg-white shadow">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex justify-between items-center">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Incident Details</h1>
            <p class="text-sm text-gray-500 mt-1">Reference: <span class="font-medium">@Model.Id</span></p>
        </div>
        <div class="flex space-x-3">
            <button class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition">
                <i class="fas fa-edit mr-2"></i> Edit
            </button>
            <a href="@Url.Action("ExportIncidentToPdf", "Incident", new { id = Model.Id })"
               class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition flex items-center">
                <i class="fas fa-file-pdf mr-2"></i> Download PDF
            </a>
        </div>
    </div>
</header>

<div class="bg-yellow-100 border-l-4 border-yellow-500 p-4 mb-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between">
        <div class="flex items-center">
            <i class="fas fa-exclamation-triangle text-yellow-600 mr-3 text-xl"></i>
            <div>
                <p class="text-sm text-yellow-700">Current Status: <span class="font-bold">@Model.IncidentStatus</span></p>
                <p class="text-sm text-yellow-700">Risk Level: <span class="font-bold">@Model.RiskAssessment</span></p>
            </div>
        </div>
        <div>
            @if (Model.RequiresRevision)
            {
                <span class="px-3 py-1 bg-yellow-200 text-yellow-800 rounded-full text-sm font-medium">Requires Review</span>
            }
        </div>
    </div>
</div>

<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">

    <!-- Incident Information -->
    <section class="bg-white shadow rounded-lg overflow-hidden mb-8">
        <div class="px-6 py-5 border-b border-gray-200">
            <h2 class="text-lg font-medium text-gray-900">Incident Information</h2>
        </div>
        <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <h3 class="text-md font-semibold text-gray-700 mb-4">General Details</h3>
                <dl class="space-y-3">
                    <partial name='_DisplayTuple' model='Tuple.Create("Title of Incident:", Model.TitleOfIncident)' />
                    <partial name="_DisplayTuple" model='Tuple.Create("Reported By:", Model.ReportedBy)' />
                    <partial name="_DisplayTuple" model='Tuple.Create("Title/Role:", Model.TitleRole)' />
                    <partial name="_DisplayTuple" model='Tuple.Create("Department/Unit:", Model.BranchDepartmentUnit)' />
                    <partial name="_DisplayTuple" model='Tuple.Create("First Line Risk Owner:", Model.FirstLineRiskOwner)' />
                    <partial name="_DisplayTuple" model='Tuple.Create("Incident Type:", Model.IncidentType.ToString())' />
                    <partial name="_DisplayTuple" model='Tuple.Create("Risk Type:", Model.RiskType.ToString())' />
                    <partial name="_DisplayTuple" model='Tuple.Create("Category Level:", Model.IncidentCategoryLevel.ToString())' />
                </dl>
            </div>
            <div>
                <h3 class="text-md font-semibold text-gray-700 mb-4">Timeline</h3>
                <dl class="space-y-3">
                    <partial name="_DisplayTuple" model='Tuple.Create(" Report Date:", Model.ReportDate.ToString("yyyy-MM-dd"))' />
                    <partial name="_DisplayTuple" model='Tuple.Create(" Start Date:", Model.StartDate.ToString("g"))'/>
                    <partial name="_DisplayTuple" model='Tuple.Create(" End Date:", Model.EndDate.ToString("g"))' />
                    <partial name="_DisplayTuple" model='Tuple.Create(" Discovery Date:", Model.DiscoveryDate.ToString("g"))' />
                    <partial name="_DisplayTuple" model='Tuple.Create(" Discovered By:", Model.DiscoveredBy)' />
                    @if (Model.LastReviewDate.HasValue)
                    {
                        <partial name="_DisplayTuple" model='Tuple.Create(" Last Review Date:", Model.LastReviewDate.Value.ToString("yyyy-MM-dd"))' />
                        <partial name="_DisplayTuple" model='Tuple.Create(" Reviewed By:", Model.ReviewedBy)' />
                    }
                </dl>
            </div>
        </div>
    </section>

    <!-- Staff Concerned -->
    <section class="bg-white shadow rounded-lg overflow-hidden mb-8">
        <div class="px-6 py-5 border-b border-gray-200">
            <h2 class="text-lg font-medium text-gray-900">Staff Concerned</h2>
        </div>
        <div class="p-6 overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Position</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Department</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Involvement</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @foreach (var staff in Model.StaffConcerned)
                    {
                        <tr>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@staff.Name</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@staff.TitleFunction</td>
                           
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <!-- Attached Documents Section -->
    <section class="bg-white shadow rounded-lg overflow-hidden mb-8">
        <div class="px-6 py-5 border-b border-gray-200">
            <h2 class="text-lg font-medium text-gray-900">Attached Documents</h2>
        </div>
        <div class="p-6">
            @if (Model.Documents != null && Model.Documents.Any())
            {
                <ul class="space-y-3">
                    @foreach (var doc in Model.Documents)
                    {
                        <li class="p-3 border border-gray-200 rounded-md flex justify-between items-center">
                            <div>
                                <p class="text-sm font-medium text-indigo-600">@doc.FileName</p>
                                <p class="text-xs text-gray-500">Description: @(string.IsNullOrEmpty(doc.Description) ? "N/A" : doc.Description)</p>
                                <p class="text-xs text-gray-500">Uploaded: @doc.CreateDate.ToString("yyyy-MM-dd") | Size: @((doc.FileSize / 1024.0).ToString("F1")) KB</p>
                            </div>
                            <div>
                                <a href="@Url.Action("DownloadAttachedDocument", "Incident", new { documentId = doc.Id })"
                                   class="inline-flex items-center px-3 py-1.5 border border-transparent text-xs font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                                    <i class="fas fa-download mr-2"></i>Download
                                </a>
                            </div>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-sm text-gray-500">No documents attached to this incident.</p>
            }
        </div>
    </section>

    <!-- Description, Cause, Discovery, Corrective Actions -->
    @foreach (var sec in new[] {
        Tuple.Create("Incident Description", Model.EventIncidentDescription),
        Tuple.Create("Incident Cause", Model.EventIncidentCause),
        Tuple.Create("Incident Discovery", Model.EventIncidentDiscovery),
        Tuple.Create("Corrective Actions Implemented", Model.CorrectiveActionsImplemented)
    })
    {
        <section class="bg-white shadow rounded-lg overflow-hidden mb-8">
            <div class="px-6 py-5 border-b border-gray-200">
                <h2 class="text-lg font-medium text-gray-900">@sec.Item1</h2>
            </div>
            <div class="p-6 bg-gray-50 rounded-md">
                <p class="text-sm text-gray-700">@Html.Raw(sec.Item2?.Replace("n", "<br/>"))</p>
            </div>
        </section>
    }

    <!-- Financial Impact -->
    <section class="bg-white shadow rounded-lg overflow-hidden mb-8">
        <div class="px-6 py-5 border-b border-gray-200">
            <h2 class="text-lg font-medium text-gray-900">Financial Impact</h2>
        </div>
        <div class="p-6">
            <div id="apexChart" class="w-full h-96"></div>
        </div>
    </section>

    <!-- Review History & Comments -->
    <section class="bg-white shadow rounded-lg overflow-hidden mb-8">
        <div class="px-6 py-5 border-b border-gray-200">
            <h2 class="text-lg font-medium text-gray-900">Review History & Comments</h2>
        </div>
        <div class="p-6 space-y-4">
            @if (Model.ReviewComments != null && Model.ReviewComments.Any())
            {
                foreach (var comment in Model.ReviewComments.OrderByDescending(c => c.CommentDate))
                {
                    if (User.IsInRole("Admin") || User.IsInRole("RiskManagement") || comment.IsVisibleToDepartment)
                    {
                        <div class="p-4 rounded-md @(comment.IsRevisionNote ? "bg-yellow-50 border border-yellow-200" : "bg-gray-50")">
                            <div class="flex justify-between items-center mb-1">
                                <p class="text-sm font-semibold text-gray-700">@comment.CommenterName</p>
                                <p class="text-xs text-gray-500">@comment.CommentDate.ToString("yyyy-MM-dd HH:mm")</p>
                            </div>
                            <p class="text-sm text-gray-600 whitespace-pre-wrap">@comment.CommentText</p>
                            @if (comment.IsRevisionNote)
                            {
                                <span class="mt-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-200 text-yellow-800">
                                    Revision Note
                                </span>
                            }
                        </div>
                    }
                }
            }
            else
            {
                <p class="text-sm text-gray-500">No comments yet.</p>
            }
        </div>
    </section>

    @if (User.IsInRole("Admin") || User.IsInRole("RiskManagement"))
    {
        <section class="bg-white shadow rounded-lg overflow-hidden mb-8">
            <div class="px-6 py-5 border-b border-gray-200">
                <h2 class="text-lg font-medium text-gray-900">Add New Comment</h2>
            </div>
            <div class="p-6">
                <form method="post" action="@Url.Action("AddComment", "Incident")">
                    @* @Html.AntiForgeryToken() // Add if ValidateAntiForgeryToken is used in controller *@
                    <input type="hidden" name="IncidentId" value="@Model.Id" />

                    <div>
                        <label for="CommentText" class="block text-sm font-medium text-gray-700">Comment</label>
                        <textarea name="CommentText" id="CommentText" rows="4" class="mt-1 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md focus:ring-indigo-500 focus:border-indigo-500" required></textarea>
                    </div>

                    <div class="mt-4 space-y-2">
                        <div class="flex items-start">
                            <div class="flex items-center h-5">
                                <input id="IsRevisionNote" name="IsRevisionNote" type="checkbox" value="true" class="focus:ring-indigo-500 h-4 w-4 text-indigo-600 border-gray-300 rounded">
                            </div>
                            <div class="ml-3 text-sm">
                                <label for="IsRevisionNote" class="font-medium text-gray-700">Mark as revision note</label>
                                <p class="text-gray-500">If checked, this comment will be part of a formal revision request and may trigger notifications.</p>
                            </div>
                        </div>
                        <div class="flex items-start">
                            <div class="flex items-center h-5">
                                <input id="IsVisibleToDepartment" name="IsVisibleToDepartment" type="checkbox" value="true" class="focus:ring-indigo-500 h-4 w-4 text-indigo-600 border-gray-300 rounded">
                            </div>
                            <div class="ml-3 text-sm">
                                <label for="IsVisibleToDepartment" class="font-medium text-gray-700">Make visible to department</label>
                                <p class="text-gray-500">If checked, users from the reporting department will be able to see this comment.</p>
                            </div>
                        </div>
                    </div>

                    <div class="mt-6">
                        <button type="submit" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                            Add Comment
                        </button>
                    </div>
                </form>
            </div>
        </section>
    }

    <!-- Risk Review -->
    <section class="bg-white shadow rounded-lg overflow-hidden mb-8">
        <div class="px-6 py-5 border-b border-gray-200">
            <h2 class="text-lg font-medium text-gray-900">Risk Management Review</h2>
        </div>
        <div class="p-6">
            <p class="text-sm text-gray-700 mb-4">@Model.RiskManagementNotes</p>
        </div>
    </section>
</main>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var options = {
                chart: {
                    type: 'bar',
                    height: '350'
                },
                series: [{
                    name: 'Amount (in @Model.FinancialLossCurrency)',
                    data: [
                        @Model.FinancialLossGrossAmount ?? 0,
                        @Model.FinancialLossLegalCosts ?? 0,
                        @Model.FinancialLossOtherCosts ?? 0,
                        @Model.FinancialLossRecoveryFromClient ?? 0,
                        @Model.FinancialLossRecoveryFromInsurance ?? 0,
                        @Model.FinancialLossNetLossToDate ?? 0
                    ]
                }],
                xaxis: {
                    categories: ['Gross Loss', 'Legal Costs', 'Other Costs', 'Recovery (Client)', 'Recovery (Insurance)', 'Net Loss']
                }
            };

            var chart = new ApexCharts(document.querySelector("#apexChart"), options);
            chart.render();
        });
    </script>
}
