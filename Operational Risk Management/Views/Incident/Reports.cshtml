@{
    ViewData["Title"] = "Incident Reports";
}

<div id="reportsApp" class="min-h-screen bg-gray-50">
    <!-- Header Section -->
    <div class="bg-white shadow-sm border-b">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
            <div class="flex justify-between items-center">
                <div>
                    <h1 class="text-3xl font-bold text-gray-900">Incident Reports</h1>
                    <p class="mt-2 text-gray-600">Generate comprehensive reports and analytics</p>
                </div>
                <div class="flex space-x-3">
                    <button @click="generateReport" 
                            :disabled="isGenerating"
                            class="bg-blue-600 hover:bg-blue-700 disabled:bg-blue-400 text-white px-4 py-2 rounded-lg font-medium transition-colors duration-200 flex items-center">
                        <svg v-if="!isGenerating" class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                        </svg>
                        <svg v-else class="animate-spin w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        {{ isGenerating ? 'Generating...' : 'Generate Report' }}
                    </button>
                    <button @click="scheduleReport" 
                            class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg font-medium transition-colors duration-200 flex items-center">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        Schedule
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
        <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
            <!-- Report Configuration Sidebar -->
            <div class="lg:col-span-1">
                <div class="bg-white rounded-lg shadow-sm border p-6 sticky top-6">
                    <h3 class="text-lg font-semibold text-gray-900 mb-4">Report Configuration</h3>
                    
                    <!-- Report Type -->
                    <div class="mb-6">
                        <label class="block text-sm font-medium text-gray-700 mb-2">Report Type</label>
                        <select v-model="reportConfig.type" 
                                class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                            <option value="summary">Summary Report</option>
                            <option value="detailed">Detailed Report</option>
                            <option value="financial">Financial Impact Report</option>
                            <option value="departmental">Departmental Analysis</option>
                            <option value="trend">Trend Analysis</option>
                            <option value="compliance">Compliance Report</option>
                        </select>
                    </div>

                    <!-- Date Range -->
                    <div class="mb-6">
                        <label class="block text-sm font-medium text-gray-700 mb-2">Date Range</label>
                        <div class="space-y-2">
                            <input v-model="reportConfig.startDate" 
                                   type="date" 
                                   class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                            <input v-model="reportConfig.endDate" 
                                   type="date" 
                                   class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                        </div>
                    </div>

                    <!-- Filters -->
                    <div class="mb-6">
                        <label class="block text-sm font-medium text-gray-700 mb-2">Filters</label>
                        <div class="space-y-3">
                            <select v-model="reportConfig.department" 
                                    class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                                <option value="">All Departments</option>
                                <option value="Trading">Trading</option>
                                <option value="IT">IT</option>
                                <option value="Operations">Operations</option>
                                <option value="HR">Human Resources</option>
                                <option value="Finance">Finance</option>
                                <option value="Legal">Legal</option>
                            </select>

                            <select v-model="reportConfig.riskLevel" 
                                    class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                                <option value="">All Risk Levels</option>
                                <option value="Low">Low</option>
                                <option value="Medium">Medium</option>
                                <option value="High">High</option>
                                <option value="Critical">Critical</option>
                            </select>

                            <select v-model="reportConfig.status" 
                                    class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                                <option value="">All Statuses</option>
                                <option value="Open">Open</option>
                                <option value="InReview">In Review</option>
                                <option value="Closed">Closed</option>
                                <option value="RequiresRevision">Requires Revision</option>
                            </select>
                        </div>
                    </div>

                    <!-- Export Options -->
                    <div class="mb-6">
                        <label class="block text-sm font-medium text-gray-700 mb-2">Export Format</label>
                        <div class="space-y-2">
                            <label class="flex items-center">
                                <input v-model="reportConfig.formats" value="pdf" type="checkbox" class="mr-2">
                                <span class="text-sm">PDF</span>
                            </label>
                            <label class="flex items-center">
                                <input v-model="reportConfig.formats" value="excel" type="checkbox" class="mr-2">
                                <span class="text-sm">Excel</span>
                            </label>
                            <label class="flex items-center">
                                <input v-model="reportConfig.formats" value="csv" type="checkbox" class="mr-2">
                                <span class="text-sm">CSV</span>
                            </label>
                        </div>
                    </div>

                    <!-- Include Options -->
                    <div class="mb-6">
                        <label class="block text-sm font-medium text-gray-700 mb-2">Include</label>
                        <div class="space-y-2">
                            <label class="flex items-center">
                                <input v-model="reportConfig.includeCharts" type="checkbox" class="mr-2">
                                <span class="text-sm">Charts & Graphs</span>
                            </label>
                            <label class="flex items-center">
                                <input v-model="reportConfig.includeDetails" type="checkbox" class="mr-2">
                                <span class="text-sm">Incident Details</span>
                            </label>
                            <label class="flex items-center">
                                <input v-model="reportConfig.includeFinancial" type="checkbox" class="mr-2">
                                <span class="text-sm">Financial Data</span>
                            </label>
                            <label class="flex items-center">
                                <input v-model="reportConfig.includeRecommendations" type="checkbox" class="mr-2">
                                <span class="text-sm">Recommendations</span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Main Content Area -->
            <div class="lg:col-span-3">
                <!-- Report Preview -->
                <div class="bg-white rounded-lg shadow-sm border mb-6">
                    <div class="px-6 py-4 border-b border-gray-200">
                        <h3 class="text-lg font-medium text-gray-900">Report Preview</h3>
                    </div>
                    <div class="p-6">
                        <div v-if="!reportData" class="text-center py-12">
                            <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                            </svg>
                            <h3 class="mt-2 text-sm font-medium text-gray-900">No report generated</h3>
                            <p class="mt-1 text-sm text-gray-500">Configure your report settings and click "Generate Report" to preview.</p>
                        </div>

                        <div v-else>
                            <!-- Report Header -->
                            <div class="mb-8">
                                <h2 class="text-2xl font-bold text-gray-900 mb-2">{{ reportData.title }}</h2>
                                <div class="flex items-center space-x-4 text-sm text-gray-600">
                                    <span>Generated: {{ formatDate(reportData.generatedDate) }}</span>
                                    <span>Period: {{ formatDate(reportConfig.startDate) }} - {{ formatDate(reportConfig.endDate) }}</span>
                                    <span>Total Incidents: {{ reportData.totalIncidents }}</span>
                                </div>
                            </div>

                            <!-- Executive Summary -->
                            <div class="mb-8">
                                <h3 class="text-lg font-semibold text-gray-900 mb-4">Executive Summary</h3>
                                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
                                    <div class="bg-blue-50 p-4 rounded-lg">
                                        <div class="text-2xl font-bold text-blue-600">{{ reportData.summary.totalIncidents }}</div>
                                        <div class="text-sm text-gray-600">Total Incidents</div>
                                    </div>
                                    <div class="bg-red-50 p-4 rounded-lg">
                                        <div class="text-2xl font-bold text-red-600">{{ reportData.summary.highRiskIncidents }}</div>
                                        <div class="text-sm text-gray-600">High Risk</div>
                                    </div>
                                    <div class="bg-green-50 p-4 rounded-lg">
                                        <div class="text-2xl font-bold text-green-600">${{ formatCurrency(reportData.summary.financialImpact) }}</div>
                                        <div class="text-sm text-gray-600">Financial Impact</div>
                                    </div>
                                </div>
                                <p class="text-gray-700">{{ reportData.summary.description }}</p>
                            </div>

                            <!-- Charts Section -->
                            <div v-if="reportConfig.includeCharts" class="mb-8">
                                <h3 class="text-lg font-semibold text-gray-900 mb-4">Visual Analysis</h3>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                    <div>
                                        <h4 class="font-medium text-gray-900 mb-2">Incidents by Risk Level</h4>
                                        <div id="reportRiskChart" class="h-64"></div>
                                    </div>
                                    <div>
                                        <h4 class="font-medium text-gray-900 mb-2">Incidents by Department</h4>
                                        <div id="reportDeptChart" class="h-64"></div>
                                    </div>
                                </div>
                            </div>

                            <!-- Key Findings -->
                            <div class="mb-8">
                                <h3 class="text-lg font-semibold text-gray-900 mb-4">Key Findings</h3>
                                <ul class="space-y-2">
                                    <li v-for="finding in reportData.keyFindings" :key="finding" 
                                        class="flex items-start space-x-2">
                                        <svg class="w-5 h-5 text-blue-600 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                        </svg>
                                        <span class="text-gray-700">{{ finding }}</span>
                                    </li>
                                </ul>
                            </div>

                            <!-- Recommendations -->
                            <div v-if="reportConfig.includeRecommendations" class="mb-8">
                                <h3 class="text-lg font-semibold text-gray-900 mb-4">Recommendations</h3>
                                <div class="space-y-4">
                                    <div v-for="(rec, index) in reportData.recommendations" :key="index" 
                                         class="p-4 bg-yellow-50 border-l-4 border-yellow-400 rounded">
                                        <div class="flex">
                                            <div class="flex-shrink-0">
                                                <svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                                                    <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
                                                </svg>
                                            </div>
                                            <div class="ml-3">
                                                <h4 class="text-sm font-medium text-yellow-800">{{ rec.title }}</h4>
                                                <p class="text-sm text-yellow-700 mt-1">{{ rec.description }}</p>
                                                <p class="text-xs text-yellow-600 mt-1">Priority: {{ rec.priority }}</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Detailed Data Table -->
                            <div v-if="reportConfig.includeDetails" class="mb-8">
                                <h3 class="text-lg font-semibold text-gray-900 mb-4">Incident Details</h3>
                                <div class="overflow-x-auto">
                                    <table class="min-w-full divide-y divide-gray-200">
                                        <thead class="bg-gray-50">
                                            <tr>
                                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">ID</th>
                                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Title</th>
                                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Department</th>
                                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Risk Level</th>
                                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
                                            </tr>
                                        </thead>
                                        <tbody class="bg-white divide-y divide-gray-200">
                                            <tr v-for="incident in reportData.incidents" :key="incident.id">
                                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{{ incident.id.substring(0, 8) }}</td>
                                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{{ incident.title }}</td>
                                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{{ incident.department }}</td>
                                                <td class="px-6 py-4 whitespace-nowrap">
                                                    <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full"
                                                          :class="getRiskClass(incident.riskLevel)">
                                                        {{ incident.riskLevel }}
                                                    </span>
                                                </td>
                                                <td class="px-6 py-4 whitespace-nowrap">
                                                    <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full"
                                                          :class="getStatusClass(incident.status)">
                                                        {{ incident.status }}
                                                    </span>
                                                </td>
                                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{{ formatDate(incident.date) }}</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Scheduled Reports -->
                <div class="bg-white rounded-lg shadow-sm border">
                    <div class="px-6 py-4 border-b border-gray-200">
                        <h3 class="text-lg font-medium text-gray-900">Scheduled Reports</h3>
                    </div>
                    <div class="p-6">
                        <div v-if="scheduledReports.length === 0" class="text-center py-8">
                            <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            <h3 class="mt-2 text-sm font-medium text-gray-900">No scheduled reports</h3>
                            <p class="mt-1 text-sm text-gray-500">Set up automated report generation to receive regular updates.</p>
                        </div>

                        <div v-else class="space-y-4">
                            <div v-for="schedule in scheduledReports" :key="schedule.id" 
                                 class="flex items-center justify-between p-4 border rounded-lg">
                                <div>
                                    <h4 class="font-medium text-gray-900">{{ schedule.name }}</h4>
                                    <p class="text-sm text-gray-600">{{ schedule.description }}</p>
                                    <p class="text-xs text-gray-500">Next run: {{ formatDate(schedule.nextRun) }}</p>
                                </div>
                                <div class="flex items-center space-x-2">
                                    <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full"
                                          :class="schedule.active ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800'">
                                        {{ schedule.active ? 'Active' : 'Inactive' }}
                                    </span>
                                    <button @click="editSchedule(schedule)" 
                                            class="text-blue-600 hover:text-blue-800 text-sm font-medium">Edit</button>
                                    <button @click="deleteSchedule(schedule.id)" 
                                            class="text-red-600 hover:text-red-800 text-sm font-medium">Delete</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
<script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
<script>
const { createApp } = Vue;

createApp({
    data() {
        return {
            isGenerating: false,
            reportConfig: {
                type: 'summary',
                startDate: this.getDateString(-30),
                endDate: this.getDateString(0),
                department: '',
                riskLevel: '',
                status: '',
                formats: ['pdf'],
                includeCharts: true,
                includeDetails: true,
                includeFinancial: true,
                includeRecommendations: true
            },
            reportData: null,
            scheduledReports: []
        }
    },
    mounted() {
        this.loadScheduledReports();
    },
    methods: {
        getDateString(daysOffset) {
            const date = new Date();
            date.setDate(date.getDate() + daysOffset);
            return date.toISOString().split('T')[0];
        },
        
        async generateReport() {
            this.isGenerating = true;
            
            try {
                // Simulate API call
                await new Promise(resolve => setTimeout(resolve, 2000));
                
                this.reportData = {
                    title: this.getReportTitle(),
                    generatedDate: new Date(),
                    totalIncidents: 45,
                    summary: {
                        totalIncidents: 45,
                        highRiskIncidents: 8,
                        financialImpact: 1250000,
                        description: 'During the selected period, there were 45 incidents reported across all departments. High-risk incidents account for 18% of the total, with a combined financial impact of $1.25M. The Trading department shows the highest incident frequency, requiring immediate attention to risk management protocols.'
                    },
                    keyFindings: [
                        'Trading department accounts for 35% of all incidents',
                        'Technology-related incidents increased by 15% compared to previous period',
                        'Average resolution time improved by 12%',
                        'Compliance incidents decreased by 8%'
                    ],
                    recommendations: [
                        {
                            title: 'Enhance Trading Risk Controls',
                            description: 'Implement additional automated controls and monitoring systems for trading operations.',
                            priority: 'High'
                        },
                        {
                            title: 'IT Infrastructure Review',
                            description: 'Conduct comprehensive review of IT systems to address recurring technology incidents.',
                            priority: 'Medium'
                        },
                        {
                            title: 'Staff Training Program',
                            description: 'Develop targeted training programs for departments with higher incident rates.',
                            priority: 'Medium'
                        }
                    ],
                    incidents: this.generateMockIncidents()
                };
                
                this.$nextTick(() => {
                    if (this.reportConfig.includeCharts) {
                        this.createReportCharts();
                    }
                });
                
            } catch (error) {
                console.error('Error generating report:', error);
            } finally {
                this.isGenerating = false;
            }
        },
        
        generateMockIncidents() {
            const incidents = [];
            const departments = ['Trading', 'IT', 'Operations', 'HR', 'Finance'];
            const riskLevels = ['Low', 'Medium', 'High', 'Critical'];
            const statuses = ['Open', 'InReview', 'Closed', 'RequiresRevision'];
            
            for (let i = 0; i < 10; i++) {
                incidents.push({
                    id: `INC-2024-${String(i + 1).padStart(3, '0')}`,
                    title: `Sample Incident ${i + 1}`,
                    department: departments[Math.floor(Math.random() * departments.length)],
                    riskLevel: riskLevels[Math.floor(Math.random() * riskLevels.length)],
                    status: statuses[Math.floor(Math.random() * statuses.length)],
                    date: new Date(Date.now() - Math.random() * 30 * 24 * 60 * 60 * 1000)
                });
            }
            
            return incidents;
        },
        
        createReportCharts() {
            // Risk Level Chart
            const riskOptions = {
                series: [12, 18, 10, 5],
                chart: {
                    type: 'donut',
                    height: 256
                },
                labels: ['Low', 'Medium', 'High', 'Critical'],
                colors: ['#10B981', '#F59E0B', '#F97316', '#DC2626'],
                legend: {
                    position: 'bottom'
                }
            };
            
            const riskChart = new ApexCharts(document.querySelector("#reportRiskChart"), riskOptions);
            riskChart.render();
            
            // Department Chart
            const deptOptions = {
                series: [{
                    data: [15, 12, 8, 6, 4]
                }],
                chart: {
                    type: 'bar',
                    height: 256,
                    horizontal: true
                },
                colors: ['#3B82F6'],
                xaxis: {
                    categories: ['Trading', 'IT', 'Operations', 'HR', 'Finance']
                }
            };
            
            const deptChart = new ApexCharts(document.querySelector("#reportDeptChart"), deptOptions);
            deptChart.render();
        },
        
        getReportTitle() {
            const types = {
                'summary': 'Incident Summary Report',
                'detailed': 'Detailed Incident Analysis',
                'financial': 'Financial Impact Report',
                'departmental': 'Departmental Analysis Report',
                'trend': 'Incident Trend Analysis',
                'compliance': 'Compliance Report'
            };
            return types[this.reportConfig.type] || 'Incident Report';
        },
        
        scheduleReport() {
            // Implementation for scheduling reports
            console.log('Schedule report functionality');
        },
        
        loadScheduledReports() {
            // Mock scheduled reports
            this.scheduledReports = [
                {
                    id: 1,
                    name: 'Weekly Summary Report',
                    description: 'Automated weekly incident summary',
                    nextRun: new Date(Date.now() + 7 * 24 * 60 * 60 * 1000),
                    active: true
                },
                {
                    id: 2,
                    name: 'Monthly Financial Report',
                    description: 'Monthly financial impact analysis',
                    nextRun: new Date(Date.now() + 30 * 24 * 60 * 60 * 1000),
                    active: true
                }
            ];
        },
        
        editSchedule(schedule) {
            console.log('Edit schedule:', schedule);
        },
        
        deleteSchedule(id) {
            this.scheduledReports = this.scheduledReports.filter(s => s.id !== id);
        },
        
        formatDate(date) {
            return new Date(date).toLocaleDateString();
        },
        
        formatCurrency(amount) {
            return (amount / 1000000).toFixed(2) + 'M';
        },
        
        getRiskClass(risk) {
            const classes = {
                'Low': 'bg-green-100 text-green-800',
                'Medium': 'bg-yellow-100 text-yellow-800',
                'High': 'bg-orange-100 text-orange-800',
                'Critical': 'bg-red-100 text-red-800'
            };
            return classes[risk] || 'bg-gray-100 text-gray-800';
        },
        
        getStatusClass(status) {
            const classes = {
                'Open': 'bg-yellow-100 text-yellow-800',
                'InReview': 'bg-blue-100 text-blue-800',
                'Closed': 'bg-green-100 text-green-800',
                'RequiresRevision': 'bg-red-100 text-red-800'
            };
            return classes[status] || 'bg-gray-100 text-gray-800';
        }
    }
}).mount('#reportsApp');
</script>

