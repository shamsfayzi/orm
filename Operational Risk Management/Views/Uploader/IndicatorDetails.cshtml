@model Operational_Risk_Management.Models.View_Models.Uploader.Indicator.VM_IndicatorDetails

<div class="max-w-5xl mx-auto px-4 py-8">
    <div class="bg-white shadow-xl rounded-2xl overflow-hidden border border-gray-200">
        <!-- Header -->
        <div class="bg-gradient-to-r from-blue-600 to-blue-500 text-white px-6 py-4 flex justify-between items-center">
            <h2 class="text-xl font-semibold">@Model.IndicatorName</h2>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium @Model.StatusBadgeClass">
                <svg class="w-3 h-3 mr-1 fill-current" viewBox="0 0 8 8"><circle cx="4" cy="4" r="3" /></svg>
                @(Model.IsActive ? "Active" : "Inactive")
            </span>
        </div>

        <!-- Body -->
        <div class="px-6 py-6 space-y-8">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <!-- General Information -->
                <div>
                    <h3 class="text-gray-600 font-semibold mb-4 flex items-center">
                        <svg class="w-5 h-5 text-blue-500 mr-2" fill="none" stroke="currentColor" stroke-width="2"
                             viewBox="0 0 24 24">
                            <path d="M13 16h-1v-4h-1m1-4h.01M12 18a9 9 0 100-18 9 9 0 000 18z" />
                        </svg>
                        General Information
                    </h3>
                    <dl class="space-y-3 text-sm">
                        <div class="flex justify-between">
                            <dt class="text-gray-500">KRI Type:</dt>
                            <dd class="text-gray-900 font-medium">@Model.KRIType</dd>
                        </div>
                        <div class="flex justify-between">
                            <dt class="text-gray-500">Reference No:</dt>
                            <dd class="text-gray-900 font-medium">@Model.RfNo</dd>
                        </div>
                        <div class="flex justify-between">
                            <dt class="text-gray-500">Process:</dt>
                            <dd class="text-gray-900 font-medium">@Model.Process</dd>
                        </div>
                        <div class="flex justify-between">
                            <dt class="text-gray-500">Risk Area:</dt>
                            <dd class="text-gray-900 font-medium">@Model.RiskArea</dd>
                        </div>
                    </dl>
                </div>

                <!-- Review Details -->
                <div>
                    <h3 class="text-gray-600 font-semibold mb-4 flex items-center">
                        <svg class="w-5 h-5 text-blue-500 mr-2" fill="none" stroke="currentColor" stroke-width="2"
                             viewBox="0 0 24 24">
                            <path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        Review Details
                    </h3>
                    <dl class="space-y-3 text-sm">
                        <div class="flex justify-between">
                            <dt class="text-gray-500">Frequency:</dt>
                            <dd>
                                <span class="bg-blue-100 text-blue-800 px-3 py-1 rounded-full font-medium">@Model.FrequencyOfReview</span>
                            </dd>
                        </div>
                        <div class="flex justify-between">
                            <dt class="text-gray-500">Next Due:</dt>
                            <dd class="@Model.DueStatusClass font-medium">
                                @(Model.NextDueDate?.ToString("dd MMM yyyy") ?? "Not available")
                            </dd>
                        </div>
                        <div class="flex justify-between">
                            <dt class="text-gray-500">Submissions:</dt>
                            <dd class="text-gray-900 font-medium">@Model.SubmissionCount</dd>
                        </div>
                        <div class="flex justify-between">
                            <dt class="text-gray-500">Last Updated:</dt>
                            <dd class="text-gray-900 font-medium">@Model.FormattedUpdatedAt</dd>
                        </div>
                    </dl>
                </div>
            </div>

            <!-- Actions -->
            <div class="flex justify-between items-center pt-4 border-t border-gray-200">
                <a asp-action="Indicators"
                   class="inline-flex items-center text-sm text-gray-600 hover:text-gray-800 transition">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" stroke-width="2"
                         viewBox="0 0 24 24">
                        <path d="M15 19l-7-7 7-7" />
                    </svg>
                    Back
                </a>
            </div>
        </div>
    </div>
</div>
