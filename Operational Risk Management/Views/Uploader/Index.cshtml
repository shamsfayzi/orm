@model Operational_Risk_Management.Models.View_Models.Uploader.VM_UploaderDashboard

@{
    ViewData["Title"] = "My Indicators Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .card-hover:hover { transform: translateY(-2px); box-shadow: 0 10px 15px -3px rgba(0,0,0,.1), 0 4px 6px -2px rgba(0,0,0,.05); }
        .status-card { transition: all .3s ease; }
        .fade-in { animation: fadeIn .5s ease forwards; }
        .rotate-icon { transition: transform .3s ease; }
    </style>
}

<div class="bg-gray-50">
    <div class="container mx-auto px-4 py-8 max-w-7xl">
        <!-- Header Section -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
            <div class="space-y-2">
                <h1 class="text-3xl font-bold text-gray-800 flex items-center gap-3">
                    <i class="fas fa-chart-line text-blue-600"></i> My Indicators Dashboard
                </h1>
                <p class="text-gray-600">Welcome, @Model.TemplateFocalPoint (@Model.DepartmentName). Manage your assigned risk indicators and submissions.</p>
            </div>

            <div class="flex flex-col sm:flex-row gap-4 items-center">
                <div class="bg-gradient-to-r from-blue-50 to-blue-100 p-4 rounded-xl shadow-sm border border-blue-200 min-w-[200px]">
                    <p class="text-sm text-blue-800 font-medium flex items-center gap-2">
                        <i class="fas fa-layer-group"></i> Total Assigned Indicators
                    </p>
                    <p class="text-2xl font-bold text-blue-900 mt-1">@Model.Indicators.Count</p>
                </div>
                <a asp-action="Indicators" asp-controller="Uploader" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 flex items-center gap-2 shadow-sm">
                    <i class="fas fa-tasks"></i> View All My Indicators
                </a>
            </div>
        </div>

        @if (!Model.Indicators.Any())
        {
            <div class="bg-white rounded-xl shadow-sm p-8 text-center fade-in">
                <div class="mx-auto w-24 h-24 bg-gray-100 rounded-full flex items-center justify-center mb-6">
                    <i class="fas fa-folder-open text-3xl text-gray-400"></i>
                </div>
                <h3 class="text-xl font-medium text-gray-900 mb-3">No indicators assigned</h3>
                <p class="text-gray-500 mb-6 max-w-md mx-auto">You don't have any indicators assigned to you yet. Please contact your administrator.</p>
            </div>
        }
        else
        {
            <!-- Status Summary Cards -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
                @{
                    var statusList = new[] {
                        new { Status = "Open for Submission", Color = "blue", Icon = "fa-edit", Count = Model.OpenSubmissionCount },
                        new { Status = "Pending Review", Color = "yellow", Icon = "fa-clock", Count = Model.PendingCount },
                        new { Status = "Approved", Color = "green", Icon = "fa-check-circle", Count = Model.ApprovedCount },
                        new { Status = "Requires Revision", Color = "red", Icon = "fa-exclamation-circle", Count = Model.RejectedCount }
                    };
                }
                @for (int i = 0; i < statusList.Length; i++)
                {
                    var s = statusList[i];
                    <a asp-action="Submissions" asp-controller="Uploader" asp-route-statusFilter="@s.Status.Replace(" ", "")" class="status-card bg-white p-5 rounded-xl shadow-sm border-l-4 border-@s.Color-500 hover:border-@s.Color-600 card-hover fade-in h-full flex flex-col justify-between" style="animation-delay: 0.@(i + 1)s">
                        <div class="flex items-center gap-4">
                            <div class="p-3 rounded-full bg-@s.Color-50 text-@s.Color-600">
                                <i class="fas @s.Icon text-xl"></i>
                            </div>
                            <div>
                                <p class="text-sm font-medium text-gray-500">@s.Status</p>
                                <p class="text-2xl font-semibold text-gray-800">@s.Count</p>
                            </div>
                        </div>
                        <div class="mt-3 text-xs text-@s.Color-600 flex items-center gap-1">
                            <span>View Details</span>
                            <i class="fas fa-chevron-right"></i>
                        </div>
                    </a>
                }
            </div>

            <!-- Action Required Indicators Section -->
            @if (Model.ActionRequiredIndicators.Any())
            {
                <div class="bg-white rounded-xl shadow-sm p-6 mb-8 fade-in" style="animation-delay: 0.5s">
                    <div class="flex justify-between items-center mb-6">
                        <h2 class="text-xl font-semibold text-gray-800 flex items-center gap-3">
                            <i class="fas fa-bell text-orange-500"></i> Action Required
                        </h2>
                        <a asp-action="Indicators" asp-controller="Uploader" class="text-sm text-blue-600 hover:text-blue-800">View All Indicators</a>
                    </div>
                    <div class="space-y-4">
                        @foreach(var indicator in Model.ActionRequiredIndicators.Take(5)) // Show top 5 or so
                        {
                            <div class="flex items-start pb-4 border-b border-gray-100 last:border-b-0 last:pb-0">
                                <div class="bg-orange-100 p-2 rounded-full mr-4">
                                    <i class="fas fa-exclamation-triangle text-orange-600"></i>
                                </div>
                                <div class="flex-1">
                                    <p class="font-medium text-gray-700">@indicator.IndicatorName</p>
                                    <p class="text-sm text-gray-500">
                                        Status: @indicator.LastSubmissionStatus.
                                        @if(indicator.DueDate.HasValue) {
                                            <span>Due: @indicator.DueDate.Value.ToString("dd MMM yyyy")</span>
                                        }
                                    </p>
                                </div>
                                @if (indicator.CanSubmitNewReport)
                                {
                                     <a asp-action="ManageSubmission" asp-controller="Uploader" asp-route-indicatorId="@indicator.IndicatorId" class="px-3 py-1.5 text-xs bg-orange-500 text-white rounded-md hover:bg-orange-600 transition-colors">
                                        Submit/Update
                                    </a>
                                } else if (indicator.LastSubmissionId.HasValue && indicator.LastSubmissionId != Guid.Empty)
                                {
                                    <a asp-action="ViewSubmission" asp-controller="Uploader" asp-route-id="@indicator.LastSubmissionId" class="px-3 py-1.5 text-xs bg-gray-200 text-gray-700 rounded-md hover:bg-gray-300 transition-colors">
                                        View
                                    </a>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="bg-white rounded-xl shadow-sm overflow-hidden fade-in" style="animation-delay: 0.6s">
                 <div class="border-b border-gray-200 px-6 py-4 flex justify-between items-center bg-gray-50">
                    <h2 class="text-xl font-semibold text-gray-800 flex items-center gap-3">
                        <i class="fas fa-folder-open text-blue-600"></i> My Indicators Overview
                    </h2>
                 </div>
                 <div class="divide-y divide-gray-200 p-4">
                    @if(Model.Indicators.Any())
                    {
                        @foreach (var indicator in Model.Indicators.Take(10)) // Display a subset or implement pagination
                        {
                            <div class="py-4 group">
                                <div class="flex justify-between items-center">
                                    <div>
                                        <h3 class="font-medium text-gray-800">@indicator.IndicatorName <span class="text-xs text-gray-500">(@indicator.RfNo)</span></h3>
                                        <p class="text-sm text-gray-500">Frequency: @indicator.FrequencyOfReview | Last Status: @indicator.LastSubmissionStatus</p>
                                    </div>
                                    <div>
                                         @if (indicator.CanSubmitNewReport)
                                        {
                                            <a asp-action="ManageSubmission" asp-controller="Uploader" asp-route-indicatorId="@indicator.IndicatorId" class="px-3 py-1.5 text-xs bg-blue-500 text-white rounded-md hover:bg-blue-600 transition-colors">
                                                Submit/Update
                                            </a>
                                        } else if (indicator.LastSubmissionId.HasValue && indicator.LastSubmissionId != Guid.Empty) {
                                             <a asp-action="ViewSubmission" asp-controller="Uploader" asp-route-id="@indicator.LastSubmissionId" class="px-3 py-1.5 text-xs bg-gray-200 text-gray-700 rounded-md hover:bg-gray-300 transition-colors">
                                                View Last
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    } else {
                        <p class="text-center text-gray-500 py-4">No indicators to display in overview.</p>
                    }
                 </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        console.log("Uploader Dashboard Loaded with dynamic data for @Model.TemplateFocalPoint");
    </script>
}