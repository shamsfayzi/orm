@using Operational_Risk_Management.Models
@{
    ViewData["Title"] = "Uploader Dashboard";
    // In a real scenario, you might have a specific ViewModel for this page.
    // For now, using ViewStaticState for user information.
    // ViewStaticState.SimulateLogin(ViewStaticState.RoleUploader, "Uploader User", "Operations Department"); // Example for testing
}

<div class="container mx-auto px-4 py-8 max-w-7xl">
    <!-- Header Section -->
    <div class="mb-8 p-6 bg-white shadow-xl rounded-xl border border-gray-200">
        <h1 class="text-3xl font-bold text-gray-800">Welcome, @ViewStaticState.CurrentUserName!</h1>
        <p class="text-gray-600 mt-2">This is your dashboard for managing KRI submissions for the @ViewStaticState.CurrentUserDepartment department.</p>
    </div>

    <!-- Quick Actions -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
        <a asp-action="Submissions" asp-controller="Uploader" class="block p-6 bg-blue-600 hover:bg-blue-700 text-white rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
            <div class="flex items-center mb-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                <h2 class="text-xl font-semibold">View My Submissions</h2>
            </div>
            <p class="text-sm text-blue-100">Review past and current submissions, and track their status.</p>
        </a>

        <a asp-action="Indicators" asp-controller="Uploader" class="block p-6 bg-green-600 hover:bg-green-700 text-white rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
            <div class="flex items-center mb-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                <h2 class="text-xl font-semibold">My Assigned Indicators</h2>
            </div>
            <p class="text-sm text-green-100">View indicators assigned to you and submit new KRI data.</p>
        </a>

        @* Add more relevant quick action cards here if needed *@
    </div>

    <div class="bg-white shadow-xl rounded-xl border border-gray-200 p-6">
        <h3 class="text-xl font-semibold text-gray-700 mb-4">Getting Started</h3>
        <p class="text-gray-600">
            From here, you can navigate to view your assigned Key Risk Indicators (KRIs) and make new submissions,
            or review the history and status of your previous submissions.
        </p>
        <p class="text-gray-600 mt-2">
            If a submission window is locked and you need to make changes, you can request an override from the specific submission's detail page.
        </p>
    </div>

</div>

@section Scripts {
    <script>
        // Add any specific JavaScript for the Uploader Dashboard here if needed in the future
        console.log("Uploader Dashboard Loaded for @ViewStaticState.CurrentUserName");
    </script>
}