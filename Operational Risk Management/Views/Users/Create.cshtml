@using Operational_Risk_Management.Models.Common
@using Operational_Risk_Management.Models.Enums
@using Operational_Risk_Management.Models.Extensions
@using Operational_Risk_Management.Models.View_Models.Users
@model VM_AppUserCreate
@{
    var deps = ViewBag.Departments;
}
<div class="flex justify-between mb-1.5">
    <span class="font-semibold">New User form</span>
    @await Html.PartialAsync("_HeaderPageButtons")
</div>
<div class="card">
    <form asp-action="create" method="post" id="appCreate">
        @Html.AntiForgeryToken()
        <div class="grid-input grid-cols-2">
            <div>
                @Html.DisplayFor(a => a.UserName)
                <input type="text" v-model="userName" name="UserName" placeholder="Write username here" class="input">
                <span v-show="checked" class="text-sm" :class="available?'text-green-500':'text-red-500'">{{available?'Available':'Not Available'}}</span>
                @Html.ValidationMessageFor(a => a.UserName)
            </div>
            @Html.EditorFor(a => a.FullName)
            <div>
                <label for="departmentId" class="block font-medium mb-1.5 pl-1 text-sm">
                    Department
                    <span class="text-red-400">*</span>

                </label>
                <select asp-for="@Model.DepartmentId" id="departmentId" name="DepartmentId" class="py-3 px-4 pe-9 block w-full border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500 disabled:opacity-50 disabled:pointer-events-none">

                    @foreach (var item in deps)
                    {
                        <option value="@item.Id">@item.DepartmentName</option>
                    }

                </select>
                @Html.ValidationMessageFor(a => a.DepartmentId)
            </div>
            @Html.EditorFor(a => a.Phone1)
        </div>
        <div>
           
            @Html.EditorFor(a => a.KriSubmissionAccess, "Toggle")
            @Html.EditorFor(a => a.IsAdmin, "Toggle")
        </div>
        <div class="flex justify-end mt-1">
            <button type="submit" class="btn btn-fill-green btn-md">Save</button>
        </div>
    </form>

</div>


@section Scripts {
    <script>
        var appCreate = createApp({
            data() {
                return {
                    checked: false,
                    userName: '@(Model != null && !Model.UserName.IsEmptyOrNull() ? Model.UserName : "")',
                    available: false,
                    msg: "",

                }
            },
            methods: {
                CheckUserName() {
                    this.msg = "loading..."
                    this.checked = true
                    const thisVue = this
                    axios.get("/users/CheckUserNameAvailability?userName=" + this.userName).then(function (response) {
                        if (response.data) {
                            thisVue.available = true
                        } else {
                            thisVue.available = false
                        }
                    }).catch(function (error) {

                        console.log(error);
                    });
                },

            },
            watch: {
                userName(newValue, oldValue) {
                    this.CheckUserName()
                }
            }
        })
        appCreate.mount("#appCreate")

    </script>
}
