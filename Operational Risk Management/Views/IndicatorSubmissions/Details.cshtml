@model Submission

@{
    ViewData["Title"] = "Submission Details";
}

<style>
 

    /* Custom styles */
    .breach-critical {
        color: #dc2626;
    }

    .breach-normal {
        color: #16a34a;
    }

    .status-badge {
        display: inline-block;
        padding: 0.5rem 1rem;
        border-radius: 9999px;
        font-size: 0.875rem;
        font-weight: 500;
    }
</style>

<div class="container mx-auto px-4 py-8">
    @await Html.PartialAsync("_HeaderPageButtons")


    <!-- Header Section -->
    <div class="flex justify-between items-center mb-10">
        <div>
            <h1 class="text-3xl font-bold text-gray-800 mb-2">Submission Details</h1>
            <p class="text-gray-600">ID: @Model.Id</p>
        </div>
        <div class="flex space-x-4">
            <span class="@(Model.Status == "Draft" ? "bg-yellow-100 text-yellow-800" :
                      Model.Status == "Submitted" ? "bg-blue-100 text-blue-800" :
                      Model.Status == "Approved" ? "bg-green-100 text-green-800" :
                      "bg-red-100 text-red-800") status-badge">
                @Model.Status
            </span>
           
        </div>
    </div>

    <!-- Main Content Grid -->
    <!-- Basic and Indicator Information Side by Side -->
    <div class="bg-white rounded-xl shadow-md overflow-hidden mb-8">
        <div class="p-8">
            <h2 class="text-xl font-semibold text-gray-800 mb-6">Submission Summary</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Basic Info -->
                <div class="space-y-4">
                    <div>
                        <p class="text-sm text-gray-500">Reporting Month</p>
                        <p class="font-medium text-gray-800">@Html.DisplayFor(_ => Model.ReportingMonth, "datetime_date_value")</p>
                    </div>
                    <div>
                        <p class="text-sm text-gray-500">Breaches</p>
                        <p class="font-medium @(Model.Breaches > Model.Indicator.TolerableBreaches ? "breach-critical" : "breach-normal")">
                            @Model.Breaches / @Model.Indicator.TolerableBreaches
                        </p>
                    </div>
                    <div>
                        <p class="text-sm text-gray-500">Created At</p>
                        <p class="font-medium text-gray-800">@Model.CreateDate.ToString("g")</p>
                    </div>
                    <div>
                        <p class="text-sm text-gray-500">Last Updated</p>
                        <p class="font-medium text-gray-800">@(Model.UpdatedDate?.ToString("g") ?? "Never")</p>
                    </div>
                </div>

                <!-- Indicator Info -->
                <div class="space-y-4">
                    <div>
                        <p class="text-sm text-gray-500">Indicator Name</p>
                        <p class="font-medium text-gray-800">@Model.Indicator.IndicatorName</p>
                    </div>
                    <div>
                        <p class="text-sm text-gray-500">Breach Status</p>
                        <p class="font-medium @(Model.Breaches > Model.Indicator.TolerableBreaches ? "breach-critical" : "breach-normal")">
                            @(Model.Breaches > Model.Indicator.TolerableBreaches ? "Above Threshold" : "Within Limits")
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Notes + Feedback/Actions Section -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Notes Card -->
        <div class="lg:col-span-2">
            <div class="bg-white rounded-xl shadow-md overflow-hidden h-full">
                <div class="p-8">
                    <h2 class="text-xl font-semibold text-gray-800 mb-6">Notes</h2>
                    <div class="bg-gray-50 p-6 rounded-lg h-full">
                        @if (!string.IsNullOrEmpty(Model.Notes))
                        {
                            <p class="text-gray-700">@Model.Notes</p>
                        }
                        else
                        {
                            <p class="text-gray-400 italic">No notes provided</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Feedback/Actions Section -->
        <div class="space-y-8">
            <!-- Feedback Card -->
            <div class="bg-white rounded-xl shadow-md overflow-hidden">
                <div class="p-8">
                    <div class="flex justify-between items-center mb-6">
                        <h2 class="text-xl font-semibold text-gray-800">Feedback</h2>
                        <span class="bg-indigo-100 text-indigo-800 text-xs font-medium px-2.5 py-0.5 rounded-full">
                            @Model.Feedbacks.Count() @(Model.Feedbacks.Count() == 1 ? "Comment" : "Comments")
                        </span>
                    </div>

                    @if (Model.Feedbacks.Any())
                    {
                        <div class="space-y-6 mb-2">
                            @foreach (var feedback in Model.Feedbacks)
                            {
                                <div class="p-3 border border-gray-200 rounded-lg">
                                    <div class="flex justify-between items-start mb-3">
                                        <p class="font-medium text-gray-800">@(feedback.CreateBy ?? "System Admin")</p>
                                        <p class="text-xs text-gray-500">@feedback.CreateDate.ToString("g")</p>
                                    </div>
                                    <p class="text-gray-700">@feedback.FeedbackContent</p>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-8">
                            <i class="far fa-comment-dots text-gray-300 text-4xl mb-3"></i>
                            <p class="text-gray-500">No feedback yet</p>
                        </div>
                    }

                    <div class="mt-8">
                        <form asp-action="SubmitFeedback" asp-route-id="@Model.Id" method="post">
                            <label for="feedback" class="block text-sm font-medium text-gray-700 mb-3">Add Feedback</label>
                            <textarea name="content" id="feedback" rows="4" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" placeholder="Type your feedback here..."></textarea>
                            <button type="submit" class="mt-4 bg-blue-600 hover:bg-blue-700 text-white px-5 py-3 rounded-lg transition duration-200 w-full">
                                Submit Feedback
                            </button>
                        </form>

                    </div>
                </div>
            </div>
            <!-- Attachments Section -->
            @if (Model.Attachments?.Any() == true)
            {
                <div class="bg-white rounded-xl shadow-md overflow-hidden mb-8">
                    <div class="p-8">
                        <div class="flex justify-between items-center mb-6">
                            <h2 class="text-xl font-semibold text-gray-800">Attachments</h2>
                            <a href="@Url.Action("DownloadAll", new { id = Model.Id })" class="text-sm text-indigo-600 hover:underline">
                                <i class="fas fa-download mr-1"></i>Download All
                            </a>
                        </div>
                        <ul class="space-y-3">
                            @foreach (var file in Model.Attachments)
                            {
                                <li class="flex items-center justify-between bg-gray-50 px-4 py-2 rounded-lg">
                                    <span class="text-gray-700">@file.FileName</span>
                                    <a href="@Url.Action("DownloadFile", new { id = Model.Id, fileId = file.Id })"
                                       class="text-sm text-indigo-600 hover:underline">
                                        <i class="fas fa-file-download mr-1"></i>Download
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }

            <!-- Actions Card -->
            <div class="bg-white rounded-xl shadow-md overflow-hidden">
                <div class="p-8">
                    <h2 class="text-xl font-semibold text-gray-800 mb-6">Actions</h2>
                    <div class="space-y-4">
                        @if (Model.Status == "Draft")
                        {
                            <button class="w-full bg-blue-600 hover:bg-blue-700 text-white px-5 py-3 rounded-lg transition duration-200 flex items-center justify-center space-x-2">
                                <i class="fas fa-paper-plane"></i>
                                <span>Submit for Review</span>
                            </button>
                        }
                        @if (Model.Status == "Submitted")
                        {
                            <button class="w-full bg-green-600 hover:bg-green-700 text-white px-5 py-3 rounded-lg transition duration-200 flex items-center justify-center space-x-2">
                                <i class="fas fa-check"></i>
                                <span>Approve</span>
                            </button>
                            <button class="w-full bg-red-600 hover:bg-red-700 text-white px-5 py-3 rounded-lg transition duration-200 flex items-center justify-center space-x-2">
                                <i class="fas fa-times"></i>
                                <span>Reject</span>
                            </button>
                        }
                        <button class="w-full bg-gray-100 hover:bg-gray-200 text-gray-800 px-5 py-3 rounded-lg transition duration-200 flex items-center justify-center space-x-2">
                            <i class="fas fa-history"></i>
                            <span>View History</span>
                        </button>
                        <button class="w-full bg-red-100 hover:bg-red-200 text-red-800 px-5 py-3 rounded-lg transition duration-200 flex items-center justify-center space-x-2">
                            <i class="fas fa-trash-alt"></i>
                            <span>Delete Submission</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Include Font Awesome for icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />