@using System.Globalization
@model PaginatedModel<Operational_Risk_Management.Models.Entities.Template>
@{
    ViewData["Title"] = "Template Details";
    // Assuming KRITemplate includes Department, FocalPoint, CreatedDate, Indicators
    // Assuming KRIIndicator includes RfNo, Process, Indicator, TolerableBreaches, TotalProcess, IsActive, Submissions
    // Assuming KRISubmission includes CreateDate, CreatedByFullName, Breaches, Notes
    // Assuming PaginatedModel includes Items, SelectedYear, SelectedMonth
    var template = Model.Items.FirstOrDefault(); // Get the single template data
    var indicators = template?.Indicators ?? new List<Indicator>();
    var submissions = indicators.SelectMany(ind => ind.Submissions ?? new List<Submission>()).ToList();
}

<div id="template-details-app" class="max-w-7xl mx-auto px-4 sm:px-6 py-6">
    <!-- Header Row -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
        <div>
            <h1 class="text-xl font-bold text-gray-800 dark:text-neutral-100">@template.Department.DepartmentName Indicators & Submissions</h1>
            @* <p class="text-sm text-gray-600 dark:text-neutral-400">@template.Department.DepartmentName</p> *@
        </div>

        <div class="flex flex-wrap gap-2">
            <button type="button" asp-action="AddIndicator" asp-route-id="@template.Id"
                    class="hs-button-active:scale-[.98] py-2 px-3 inline-flex items-center gap-x-1.5 text-sm font-medium rounded-lg border border-transparent bg-blue-600 text-white hover:bg-blue-700">
                <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                Add Indicator
            </button>

            <a href="/KRI/Templates"
               class="py-2 px-3 inline-flex items-center gap-x-1.5 text-sm font-medium rounded-lg border border-gray-200 bg-white text-gray-800 hover:bg-gray-50 dark:bg-neutral-800 dark:border-neutral-700 dark:text-white dark:hover:bg-neutral-700">
                <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                Back to Templates
            </a>
        </div>
    </div>

    <!-- Stats Row -->
    <div class="flex flex-col sm:flex-row gap-3 mb-6 mt-1">
        <div class="flex-1 min-w-0 p-3 bg-white border border-gray-200 rounded-lg dark:bg-neutral-800 dark:border-neutral-700">
            <p class="text-xs font-medium text-gray-500 dark:text-neutral-400 truncate">Department</p>
            <p class="text-sm font-medium text-gray-800 dark:text-neutral-200 truncate">@template.Department.DepartmentName</p>
        </div>

        <div class="flex-1 min-w-0 p-3 bg-white border border-gray-200 rounded-lg dark:bg-neutral-800 dark:border-neutral-700">
            <p class="text-xs font-medium text-gray-500 dark:text-neutral-400 truncate">Focal Point</p>
            <p class="text-sm font-medium text-gray-800 dark:text-neutral-200 truncate">@(template.FocalPoint ?? "Not assigned")</p>
        </div>

        <div class="flex-1 min-w-0 p-3 bg-white border border-gray-200 rounded-lg dark:bg-neutral-800 dark:border-neutral-700">
            <p class="text-xs font-medium text-gray-500 dark:text-neutral-400 truncate">Created</p>
            <p class="text-sm font-medium text-gray-800 dark:text-neutral-200 truncate">@Html.DisplayFor(_ => template.CreateDate, "datetime_date_value")</p>
        </div>
    </div>
        <div class="mb-4 border-b border-gray-200">
            <div class="flex bg-gray-100 hover:bg-gray-200 rounded-lg transition p-1 dark:bg-neutral-700 dark:hover:bg-neutral-600">

                <nav class="flex gap-x-1" aria-label="Tabs" role="tablist" aria-orientation="horizontal">
                    <button type="button"
                            class="hs-tab-active:bg-white hs-tab-active:text-gray-700 hs-tab-active:dark:bg-neutral-800 hs-tab-active:dark:text-neutral-400
                            dark:hs-tab-active:bg-gray-800 py-3 px-4 inline-flex items-center gap-x-2 bg-transparent text-sm text-gray-500 hover:text-gray-700
                            focus:outline-hidden focus:text-gray-700 font-medium rounded-lg hover:hover:text-blue-600 disabled:opacity-50 disabled:pointer-events-none dark:text-neutral-400
                            dark:hover:text-white dark:focus:text-white active" 
                        data-hs-tab="#tabs-indicators"
                        aria-controls="tabs-indicators"
                        role="tab"
                         @@click="switchTab('indicators')"> 
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    Indicators
                </button>

                <button type="button"
                            class="hs-tab-active:bg-white hs-tab-active:text-gray-700 hs-tab-active:dark:bg-neutral-800 hs-tab-active:dark:text-neutral-400 dark:hs-tab-active:bg-gray-800 py-3 px-4 inline-flex items-center gap-x-2 bg-transparent 
                            text-sm text-gray-500 hover:text-gray-700 focus:outline-hidden focus:text-gray-700 font-medium rounded-lg hover:hover:text-blue-600 disabled:opacity-50 disabled:pointer-events-none
                            dark:text-neutral-400 dark:hover:text-white dark:focus:text-white" 
                        id="tabs-submissions-item"
                        data-hs-tab="#tabs-submissions"
                        aria-controls="tabs-submissions"
                        role="tab"
                        @@click="switchTab('submissions')">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                    </svg>
                    Monthly Submissions
                </button>
            </nav>
            </div>
        </div>
        <div>
            <div id="tabs-indicators" role="tabpanel" aria-labelledby="tabs-indicators-item">
                @if (Model.Items.Any() && Model.Items.First().Indicators.Any())
                {
                    <div class="mb-4">
                        <div class="relative">
                            <div class="absolute inset-y-0 start-0 flex items-center pointer-events-none ps-3">
                                <svg class="size-4 text-gray-400 dark:text-neutral-500" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                            </div>
                            <input type="text" v-model="indicatorSearch" placeholder="Search indicators..." class="py-2 px-4 ps-10 block w-full border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500 disabled:opacity-50 disabled:pointer-events-none dark:bg-neutral-900 dark:border-neutral-700 dark:text-neutral-400 dark:placeholder-neutral-500 dark:focus:ring-neutral-600">
                        </div>
                    </div>
                    @if(Model.Items.Count() > 0)
                    {

                        <div  class="flex flex-col">
                            <div class="-m-1.5 overflow-x-auto">
                                <div class="p-1.5 min-w-full inline-block align-middle">
                                    <div class="border rounded-lg overflow-hidden dark:border-neutral-700">
                                        <table class="min-w-full divide-y divide-gray-200 dark:divide-neutral-700">
                                            <thead class="bg-gray-50 dark:bg-neutral-800">
                                                <tr>
                                                    <th scope="col" class="px-6 py-3 text-start text-xs font-medium text-gray-500 uppercase dark:text-neutral-400">Ref No.</th>
                                                    <th scope="col" class="px-6 py-3 text-start text-xs font-medium text-gray-500 uppercase dark:text-neutral-400">Process</th>
                                                    <th scope="col" class="px-6 py-3 text-start text-xs font-medium text-gray-500 uppercase dark:text-neutral-400">Indicator</th>
                                                    <th scope="col" class="px-6 py-3 text-start text-xs font-medium text-gray-500 uppercase dark:text-neutral-400">Tolerable Breaches</th>
                                                    <th scope="col" class="px-6 py-3 text-start text-xs font-medium text-gray-500 uppercase dark:text-neutral-400">Total Process</th>
                                                    <th scope="col" class="px-6 py-3 text-end text-xs font-medium text-gray-500 uppercase dark:text-neutral-400">Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody class="divide-y divide-gray-200 dark:divide-neutral-700">
                                                @foreach(var indicator in template.Indicators)
                                                {
                                                    
                                                <tr class="hover:bg-gray-100 dark:hover:bg-neutral-700">
                                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-800 dark:text-neutral-200">@indicator.RfNo</td>
                                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-800 dark:text-neutral-200">@indicator.Process</td>
                                                <td class="px-6 py-4 text-sm text-gray-800 dark:text-neutral-200 max-w-xs truncate" >@indicator.IndicatorName </td>
                                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-800 dark:text-neutral-200">@indicator.TolerableBreaches</td>
                                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-800 dark:text-neutral-200">@indicator.TotalProcess</td>
                                                <td class="px-6 py-4 whitespace-nowrap text-end text-sm font-medium">
                                                     <div class="flex justify-end space-x-1">
                                                        <button type="button" @@click="editIndicator(indicator)" class="inline-flex items-center gap-x-2 text-sm font-semibold rounded-lg border border-transparent text-blue-600 hover:text-blue-800 disabled:opacity-50 disabled:pointer-events-none dark:text-blue-500 dark:hover:text-blue-400" title="Edit">
                                                            <svg class="flex-shrink-0 size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                                                        </button>
                                                        <button type="button" @@click="viewIndicator(indicator)" class="inline-flex items-center gap-x-2 text-sm font-semibold rounded-lg border border-transparent text-gray-600 hover:text-gray-800 disabled:opacity-50 disabled:pointer-events-none dark:text-neutral-400 dark:hover:text-neutral-200" title="View Details">
                                                             <svg class="flex-shrink-0 size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                                                        </button>
                                                         <button type="button" @@click="confirmDeleteIndicator(indicator)" class="inline-flex items-center gap-x-2 text-sm font-semibold rounded-lg border border-transparent text-red-600 hover:text-red-800 disabled:opacity-50 disabled:pointer-events-none dark:text-red-500 dark:hover:text-red-400" title="Delete">
                                                            <svg class="flex-shrink-0 size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/></svg>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                                }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    }
                    if(template.Indicators.Count < 1){
                    <div  class="text-center py-12">
                         <div class="bg-white border shadow-sm rounded-xl p-4 md:p-8 dark:bg-neutral-900 dark:border-neutral-700">
                              <svg class="mx-auto size-10 text-gray-400 dark:text-neutral-500" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                              <h3 class="mt-4 text-lg font-medium text-gray-800 dark:text-neutral-200">No matching indicators</h3>
                              <p class="mt-2 text-sm text-gray-600 dark:text-neutral-400">Your search for "{{ indicatorSearch }}" did not return any results.</p>
                              <div class="mt-6">
                                  <button type="button" @@click="indicatorSearch = ''" class="py-2 px-3 inline-flex items-center gap-x-2 text-sm font-medium rounded-lg border border-gray-200 bg-white text-gray-800 shadow-sm hover:bg-gray-50 dark:bg-neutral-900 dark:border-neutral-700 dark:text-white dark:hover:bg-neutral-800">
                                       Clear Search
                                  </button>
                              </div>
                         </div>
                     </div>
                     }
                }
                @if (!Model.Items.Any() || !Model.Items.First().Indicators.Any())
                {
                    <div class="text-center py-12">
                         <div class="bg-white border shadow-sm rounded-xl p-4 md:p-8 dark:bg-neutral-900 dark:border-neutral-700">
                             <svg class="mx-auto size-10 text-gray-400 dark:text-neutral-500" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" x2="8" y1="13" y2="13"/><line x1="16" x2="8" y1="17" y2="17"/><line x1="10" x2="8" y1="9" y2="9"/></svg>
                             <h3 class="mt-4 text-lg font-medium text-gray-800 dark:text-neutral-200">No indicators found</h3>
                             <p class="mt-2 text-sm text-gray-600 dark:text-neutral-400">This template doesn't have any indicators yet.</p>
                             <div class="mt-6">
                                  <button type="button" @@click="openAddIndicatorModal()"
                                          class="py-2 px-3 inline-flex items-center gap-x-2 text-sm font-semibold rounded-lg border border-transparent bg-blue-600 text-white hover:bg-blue-700 disabled:opacity-50 disabled:pointer-events-none">
                                      <svg class="flex-shrink-0 size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                                      Add Indicator
                                  </button>
                             </div>
                         </div>
                    </div>
                }
            </div>

             <div id="tabs-submissions" class="hidden" role="tabpanel" aria-labelledby="tabs-submissions-item" >
                 @if (submissions.Any())
                 {
                     <form method="get" asp-action="TemplateDetails" asp-route-id="@template?.Id" class="mb-6 p-4 border rounded-lg bg-gray-50 dark:bg-neutral-800 dark:border-neutral-700">
                         <div class="grid sm:flex sm:items-center sm:justify-between gap-4">
                              <input type="hidden" name="tab" value="submissions" /> <div class="flex items-center gap-x-2">
                                   <label for="yearFilter" class="text-sm text-gray-700 dark:text-neutral-300">Year:</label>
                                   <select id="yearFilter" name="SelectedYear" asp-for="@Model.SelectedYear" class="py-2 px-3 pe-9 block w-full border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500 dark:bg-neutral-900 dark:border-neutral-700 dark:text-neutral-400">
                                        <option value="">All</option>
                                         @{
                                            var submissionYears = submissions
                                                .Select(s => s.CreateDate.Year)
                                                .Distinct()
                                                .OrderBy(y => y);
                                        }
                                        @foreach (var year in submissionYears)
                                        {
                                            <option value="@year" selected="@(Model.SelectedYear == year)">@year</option>
                                        }
                                    </select>
                               </div>
                               <div class="flex items-center gap-x-2">
                                   <label for="monthFilter" class="text-sm text-gray-700 dark:text-neutral-300">Month:</label>
                                    <select id="monthFilter" name="SelectedMonth" asp-for="@Model.SelectedMonth" class="py-2 px-3 pe-9 block w-full border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500 dark:bg-neutral-900 dark:border-neutral-700 dark:text-neutral-400">
                                        <option value="">All</option>
                                        @for (int i = 1; i <= 12; i++)
                                        {
                                            <option value="@i" selected="@(Model.SelectedMonth == i)">@CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i)</option>
                                        }
                                    </select>
                               </div>
                              <button type="submit" class="py-2 px-3 inline-flex items-center gap-x-2 text-sm font-semibold rounded-lg border border-transparent bg-blue-600 text-white hover:bg-blue-700">
                                  Apply Filters
                              </button>
                         </div>
                     </form>

                      <div class="flex flex-col">
                        <div class="-m-1.5 overflow-x-auto">
                            <div class="p-1.5 min-w-full inline-block align-middle">
                                <div class="border rounded-lg overflow-hidden dark:border-neutral-700">
                                     <table class="min-w-full divide-y divide-gray-200 dark:divide-neutral-700">
                                        <thead class="bg-gray-50 dark:bg-neutral-800">
                                             <tr>
                                                <th scope="col" class="px-6 py-3 text-start text-xs font-medium text-gray-500 uppercase dark:text-neutral-400">Process</th>
                                                <th scope="col" class="px-6 py-3 text-start text-xs font-medium text-gray-500 uppercase dark:text-neutral-400">Submitted By</th>
                                                <th scope="col" class="px-6 py-3 text-start text-xs font-medium text-gray-500 uppercase dark:text-neutral-400">Submission Date</th>
                                                <th scope="col" class="px-6 py-3 text-start text-xs font-medium text-gray-500 uppercase dark:text-neutral-400">Risk Tolerance</th>
                                                <th scope="col" class="px-6 py-3 text-start text-xs font-medium text-gray-500 uppercase dark:text-neutral-400">Notes</th>
                                                <th scope="col" class="px-6 py-3 text-start text-xs font-medium text-gray-500 uppercase dark:text-neutral-400">Total Breaches</th>
                                                <th scope="col" class="px-6 py-3 text-end text-xs font-medium text-gray-500 uppercase dark:text-neutral-400">Actions</th>
                                            </tr>
                                        </thead>
                                         <tbody class="divide-y divide-gray-200 dark:divide-neutral-700">
                                             @foreach (var indicator in indicators)
                                             {
                                                 
                                                    var filteredIndicatorSubmissions = indicator.Submissions?.Where(s =>
                                                        (!Model.SelectedYear.HasValue || s.CreateDate.Year == Model.SelectedYear.Value) &&
                                                        (!Model.SelectedMonth.HasValue || s.CreateDate.Month == Model.SelectedMonth.Value)
                                                    ).ToList() ?? new List<Submission>();
                                                 
                                                 @foreach (var submission in filteredIndicatorSubmissions)
                                                 {
                                                     <tr class="hover:bg-gray-100 dark:hover:bg-neutral-700">
                                                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-800 dark:text-neutral-200">@indicator.Process</td>
                                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-800 dark:text-neutral-200">@submission.CreatedByFullName</td>
                                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-800 dark:text-neutral-200">@Html.DisplayFor(_ => submission.CreateDate, "datetime_date_value")</td>
                                                         <td class="px-6 py-4 whitespace-nowrap">
                                                             @{
                                                                string badgeClass;
                                                                string toleranceStatus;
                                                                if (submission.Breaches > indicator.TolerableBreaches) {
                                                                    badgeClass = "bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200";
                                                                    toleranceStatus = "Breached";
                                                                } else if (submission.Breaches < indicator.TolerableBreaches) {
                                                                    badgeClass = "bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200";
                                                                    toleranceStatus = "Tolerable";
                                                                } else { // Assuming == means peak
                                                                     badgeClass = "bg-orange-100 text-orange-800 dark:bg-orange-900 dark:text-orange-200";
                                                                    toleranceStatus = "Peak";
                                                                }
                                                            }
                                                            <span class="inline-flex items-center gap-x-1.5 py-1.5 px-3 rounded-full text-xs font-medium @badgeClass">
                                                                @toleranceStatus
                                                            </span>
                                                        </td>
                                                         <td class="px-6 py-4 text-sm text-gray-800 dark:text-neutral-200 max-w-xs">
                                                             <button type="button" @@click="openNoteModal(submission)" class="block truncate hover:underline text-blue-600 dark:text-blue-500" title="View Note">
                                                                 @Html.DisplayFor(_=> submission.Notes, "string_value_limit")
                                                             </button>
                                                         </td>
                                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-800 dark:text-neutral-200">@submission.Breaches</td>
                                                        <td class="px-6 py-4 whitespace-nowrap text-end text-sm font-medium">
                                                            <div class="flex justify-end space-x-1">
                                                                <button type="button" @@click="openFeedbackModal(submission)" class="inline-flex items-center gap-x-2 text-sm font-semibold rounded-lg border border-transparent text-purple-600 hover:text-purple-800 disabled:opacity-50 disabled:pointer-events-none dark:text-purple-500 dark:hover:text-purple-400" title="Give Feedback">
                                                                     <svg class="flex-shrink-0 size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 0 1 12 4a9 9 0 0 1 4.1 16"/><path d="M12 13a3 3 0 0 0-3 3h6a3 3 0 0 0-3-3"/><path d="M12 4v5"/><path d="m9 7.5 3 3 3-3"/></svg>
                                                                </button>
                                                            <a type="button" asp-action="SubmissionDetails" asp-route-id="@submission.Id" class="inline-flex items-center gap-x-2 text-sm font-semibold rounded-lg border border-transparent text-gray-600 hover:text-gray-800 disabled:opacity-50 disabled:pointer-events-none dark:text-neutral-400 dark:hover:text-neutral-200" title="View Details">
                                                                    <svg class="flex-shrink-0 size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                                                                </a>
                                                                <button type="button" @@click="downloadSubmission(submission)" class="inline-flex items-center gap-x-2 text-sm font-semibold rounded-lg border border-transparent text-green-600 hover:text-green-800 disabled:opacity-50 disabled:pointer-events-none dark:text-green-500 dark:hover:text-green-400" title="Download">
                                                                     <svg class="flex-shrink-0 size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
                                                                </button>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                 }
                                             }
                                         </tbody>
                                     </table>
                                </div>
                            </div>
                        </div>
                    </div>
                 }
                 else
                 {
                      <div class="text-center py-12">
                         <div class="bg-white border shadow-sm rounded-xl p-4 md:p-8 dark:bg-neutral-900 dark:border-neutral-700">
                              <svg class="mx-auto size-10 text-gray-400 dark:text-neutral-500" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" x2="8" y1="13" y2="13"/><line x1="16" x2="8" y1="17" y2="17"/><line x1="10" x2="8" y1="9" y2="9"/></svg>
                             <h3 class="mt-4 text-lg font-medium text-gray-800 dark:text-neutral-200">No submissions found</h3>
                              <p class="mt-2 text-sm text-gray-600 dark:text-neutral-400">
                                  No submissions match your current filters or no submissions have been made yet.
                             </p>
                         </div>
                     </div>
                 }
            </div>
        </div>

    </div>
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const app =  Vue.createApp({
            data() {
                return {
                    loading: false,
                    currentTab: new URLSearchParams(window.location.search).get('tab') || 'indicators',
                    selectedSubmissionForFeedback: null,
                }
            },
            methods: {
                switchTab(tabName) {
                    this.currentTab = tabName;
                    const url = new URL(window.location);
                    url.searchParams.set('tab', tabName);
                    window.history.pushState({}, '', url);
                },
                downloadSubmission(submission) {
                    console.log("Downloading Submission:", submission);
                    alert(`Initiating download for Submission (ID: ${submission.id})`);
                }
            },
            mounted() {
                const tabElement = document.getElementById(`tabs-${this.currentTab}-item`);
                const tabContent = document.getElementById(`tabs-${this.currentTab}`);
                if (tabElement && tabContent) {
                    console.log(`Attempting to set initial tab to: ${this.currentTab}`);
                }
            },
            watch: {
                currentTab(newTab, oldTab) {
                    console.log(`Tab changed from ${oldTab} to ${newTab}`);
                }
            }
        });
        app.mount("#template-details-app")
        });
    </script>
}