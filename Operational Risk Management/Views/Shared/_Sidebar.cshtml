        @if (ViewStaticState.IsAdmin)
        {
            <p class="px-4 py-2 text-xs font-semibold text-gray-500 uppercase tracking-wider mt-6">Administration</p>
            <a href="@Url.Action("Index", "Users")" class="flex items-center px-4 py-2.5 text-gray-700 rounded-lg hover:bg-blue-50 transition-all duration-200 @(currentPage == "users" ? " bg-blue-50 text-blue-500" : "")">
