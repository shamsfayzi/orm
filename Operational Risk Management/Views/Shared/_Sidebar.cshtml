@using Operational_Risk_Management.Models; // For ViewStaticState
@{
    var currentPage = ViewBag.CurrentPage as string ?? "";
    // To test different roles, you would call ViewStaticState.SimulateLogin("Admin", "Admin User", "IT") here or in _ViewStart.cshtml
    // For now, it will use the default set in ViewStaticState static constructor or ResetLogin.
    // Example: @ViewStaticState.SimulateLogin(ViewStaticState.RoleAdmin, "Admin User", "IT Department")
}
<nav class="mt-6">
    <div class="space-y-2">
        <!-- Dashboard -->
        <a href="@Url.Action("Index", "Home")" class="flex items-center px-4 py-2.5 text-gray-700 rounded-lg hover:bg-blue-50 transition-all duration-200 @(currentPage == "dashboard" ? " bg-blue-50 text-blue-500" : "")">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
            <span class="ml-1 text-sm font-medium">Dashboard</span>
        </a>

        <!-- KRI/Submissions Section (for Uploaders) -->
        @if (ViewStaticState.IsUploader)
        {
            <p class="px-4 py-2 text-xs font-semibold text-gray-500 uppercase tracking-wider mt-6">My Submissions</p>
            <a href="@Url.Action("Index", "Uploader")" class="flex items-center px-4 py-2.5 text-gray-700 rounded-lg hover:bg-blue-50 transition-all duration-200 @(currentPage == "myindicators" ? " bg-blue-50 text-blue-500" : "")">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                <span class="ml-1 text-sm font-medium">My Indicators</span>
            </a>
            <a href="@Url.Action("Submissions", "Uploader")" class="flex items-center px-4 py-2.5 text-gray-700 rounded-lg hover:bg-blue-50 transition-all duration-200 @(currentPage == "mysubmissions" ? " bg-blue-50 text-blue-500" : "")">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                <span class="ml-1 text-sm font-medium">View Submissions</span>
            </a>
        }

        <!-- Incident Management -->
        <p class="px-4 py-2 text-xs font-semibold text-gray-500 uppercase tracking-wider mt-6">Incident Management</p>
        <a href="@Url.Action("Index", "Incident")" class="flex items-center px-4 py-2.5 text-gray-700 rounded-lg hover:bg-blue-50 transition-all duration-200 @(currentPage == "incidents" ? " bg-blue-50 text-blue-500" : "")">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <span class="ml-1 text-sm font-medium">Incident Reports</span>
        </a>
        @if (ViewStaticState.IsUploader || ViewStaticState.IsAdmin || ViewStaticState.IsRiskManager) // Assuming all these roles can create
        {
            <a href="@Url.Action("CreateIncident", "Incident")" class="flex items-center px-4 py-2.5 text-gray-700 rounded-lg hover:bg-blue-50 transition-all duration-200 @(currentPage == "createincident" ? " bg-blue-50 text-blue-500" : "")">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v3m0 0v3m0-3h3m-3 0H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                <span class="ml-1 text-sm font-medium">Report New Incident</span>
            </a>
        }

