            </a>

            <a href="@Url.Action("Index", "TemplateIndicator")" class="flex items-center px-4 py-2.5 text-gray-700 rounded-lg hover:bg-blue-50 transition-all duration-200 @(currentPage == "indicators" ? " bg-blue-50 text-blue-500" : "")">
                 <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
