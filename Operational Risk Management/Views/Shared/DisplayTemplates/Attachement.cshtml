@model Attachment
@{
    string url = ViewData["deleteAttachementUrl"] as string;
}
<span id="attachement_@Model.Id" class="border justify-between inline-flex items-center px-2 py-1 me-2 text-sm font-medium text-blue-800 bg-blue-200 rounded dark:bg-blue-900 dark:text-blue-300">
    <a target="_blank" href="/attachements/@Model.FileName">@Model.FileName</a>
    <button type="button" title="Remove Attachement" onclick='deleteAttachement("@url","@Model.Id.ToString()")' class="inline-flex items-center p-1 ms-2 text-sm text-blue-400 bg-transparent rounded-sm hover:bg-blue-200 hover:text-blue-900 dark:hover:bg-blue-800 dark:hover:text-blue-300">
        <svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6" />
        </svg>
        <span class="sr-only">Remove</span>
    </button>
</span>