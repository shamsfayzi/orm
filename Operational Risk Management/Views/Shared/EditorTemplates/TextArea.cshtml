@model string
@{
    var displayName = ViewData.ModelMetadata.DisplayName ?? ViewData.ModelMetadata.PropertyName;
    var isRequired = ViewData.ModelMetadata.IsRequired;
    var htmlFieldPrefix = ViewData.TemplateInfo.HtmlFieldPrefix;
}

<div>
    <label for="@htmlFieldPrefix" class="block font-medium mb-1.5 pl-1 text-sm">
        @displayName
        @if (isRequired)
        {
            <span class="text-red-400">*</span>
        }
    </label>
    <textarea id="@htmlFieldPrefix" name="@htmlFieldPrefix" placeholder="Write @displayName here" class="py-3 px-4 block w-full border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500 disabled:opacity-50 disabled:pointer-events-none" rows="3">@Model</textarea>
</div>