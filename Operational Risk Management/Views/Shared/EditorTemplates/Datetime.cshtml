@model DateTime?
@{
    var displayName = ViewData.ModelMetadata.DisplayName ?? ViewData.ModelMetadata.PropertyName;
    var isRequired = ViewData.ModelMetadata.IsRequired;
    var formattedValue = Model.HasValue ? Model.Value.ToString("yyyy-MM-ddTHH:mm") : string.Empty;
}

<div>
    <label for="@ViewData.TemplateInfo.HtmlFieldPrefix" class="block font-medium mb-1.5 pl-1 text-sm">
        @displayName @if (isRequired)
        {
            <span class="text-red-400">*</span>
        }
    </label>
    <input type="datetime-local" id="@ViewData.TemplateInfo.HtmlFieldPrefix" value="@formattedValue" name="@ViewData.TemplateInfo.HtmlFieldPrefix" placeholder="Write @displayName here" class="py-3 px-4 block w-full border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500 disabled:opacity-50 disabled:pointer-events-none" aria-describedby="@ViewData.TemplateInfo.HtmlFieldPrefix">
    @Html.ValidationMessageFor(a => a)
</div>
