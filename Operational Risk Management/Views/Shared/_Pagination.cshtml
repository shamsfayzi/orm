@model Pagination
@{
    var otherQueryStrings = ViewContext.HttpContext.Request.Query
        .Where(q => q.Key != "CurrentPage" && q.Key != "pageSize")
        .ToDictionary(q => q.Key, q => q.Value.ToString());
}
<div class="flex justify-between pt-4">
    
    <div class="grid justify-center sm:flex sm:justify-start sm:items-center gap-2">
        <!-- Pagination -->
        <nav class="flex items-center gap-x-1" aria-label="Pagination">
            <!-- Previous Button -->
            <form method="get" action="" class="inline">
                @foreach (var qs in otherQueryStrings)
                {
                    <input type="hidden" name="@qs.Key" value="@qs.Value" />
                }
                <input type="hidden" name="pageSize" value="@Model.PageSize" />
                <button type="submit"
                        name="CurrentPage"
                        value="@(Model.CurrentPage - 1)"
                        class="min-h-[32px] min-w-8 py-2 px-2 inline-flex justify-center items-center gap-x-2 text-sm rounded-full border border-transparent text-gray-800 hover:bg-blue-100 focus:outline-none focus:bg-gray-100 disabled:opacity-50 disabled:pointer-events-none"
                        aria-label="Previous"
                @(Model.HasPrevious ? "" : "disabled")>
                    <svg class="shrink-0 size-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m15 18-6-6 6-6"></path>
                    </svg>
                    <span class="sr-only">Previous</span>
                </button>
            </form>

            <!-- Page Numbers -->
            <div class="flex items-center gap-x-1">
                @for (var i = 1; i <= Model.TotalPage; i++)
                {
                    @if (i == 1 || i == Model.TotalPage || (i >= Model.CurrentPage - 1 && i <= Model.CurrentPage + 1) || (i == Model.CurrentPage - 2) || (i == Model.CurrentPage + 2))
                    {
                        <form method="get" action="" class="inline">
                            @foreach (var qs in otherQueryStrings)
                            {
                                <input type="hidden" name="@qs.Key" value="@qs.Value" />
                            }
                            <input type="hidden" name="pageSize" value="@Model.PageSize" />
                            <button type="submit"
                                    name="CurrentPage"
                                    value="@i"
                                    class="min-h-[32px] min-w-8 flex justify-center items-center border @(i == Model.CurrentPage ? "border-gray-200" : "border-transparent") text-gray-800 py-1 px-2.5 text-sm rounded-full focus:outline-none focus:bg-gray-50 @(i == Model.CurrentPage ? "disabled:opacity-50 disabled:pointer-events-none" : "hover:bg-blue-100")"
                                    aria-current="@(i == Model.CurrentPage ? "page" : null)">
                                @i
                            </button>
                        </form>
                    }
                    else if (i == 2 && Model.CurrentPage > 4)
                    {
                        <span class="text-gray-800 py-1 px-2.5 text-sm">•••</span>
                    }
                    else if (i == Model.TotalPage - 1 && Model.CurrentPage < Model.TotalPage - 3)
                    {
                        <span class="text-gray-800 py-1 px-2.5 text-sm">•••</span>
                    }
                }
            </div>

            <!-- Next Button -->
            <form method="get" action="" class="inline">
                @foreach (var qs in otherQueryStrings)
                {
                    <input type="hidden" name="@qs.Key" value="@qs.Value" />
                }
                <input type="hidden" name="pageSize" value="@Model.PageSize" />
                <button type="submit"
                        name="CurrentPage"
                        value="@(Model.CurrentPage + 1)"
                        class="min-h-[32px] min-w-8 py-2 px-2 inline-flex justify-center items-center gap-x-2 text-sm rounded-full border border-transparent text-gray-800 hover:bg-blue-100 focus:outline-none focus:bg-gray-100 disabled:opacity-50 disabled:pointer-events-none"
                        aria-label="Next"
                @(Model.HasNext ? "" : "disabled")>
                    <span class="sr-only">Next</span>
                    <svg class="shrink-0 size-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m9 18 6-6-6-6"></path>
                    </svg>
                </button>
            </form>
        </nav>
        <!-- End Pagination -->

        <div class="flex justify-center items-center gap-x-5">
            <!-- Dropdown -->
            <div class="hs-dropdown [--placement:top-left] relative inline-flex">
                <button id="hs-small-pilled-bordered-pagination-dropdown" type="button" class="hs-dropdown-toggle min-h-[32px] py-1 px-2 inline-flex items-center gap-x-1 text-sm rounded-lg border border-gray-200 text-gray-800 shadow-sm hover:bg-blue-50 focus:outline-none focus:bg-gray-100 disabled:opacity-50 disabled:pointer-events-none" aria-haspopup="menu" aria-expanded="false" aria-label="Dropdown">
                    @Model.PageSize per page
                    <svg class="shrink-0 size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m6 9 6 6 6-6"></path>
                    </svg>
                </button>
                <div class="hs-dropdown-menu hs-dropdown-open:opacity-100 w-48 hidden z-50 transition-[margin,opacity] opacity-0 duration-300 mb-2 bg-white shadow-md rounded-lg p-1 space-y-0.5" role="menu" aria-orientation="vertical" aria-labelledby="hs-small-pilled-bordered-pagination-dropdown">
                    @foreach (var size in new[] { 10, 30, 50,100 })
                    {
                        <form method="get" action="" class="w-full">
                            @foreach (var qs in otherQueryStrings)
                            {
                                <input type="hidden" name="@qs.Key" value="@qs.Value" />
                            }
                            <button type="submit"
                                    name="pageSize"
                                    value="@size"
                                    class="w-full flex items-center gap-x-3.5 py-2 px-3 rounded-lg text-sm text-gray-800 hover:bg-blue-100 focus:outline-none focus:bg-gray-100 disabled:opacity-50 disabled:pointer-events-none">
                                @size per page
                                @if (Model.PageSize == size)
                                {
                                    <svg class="ms-auto shrink-0 size-4 text-blue-600" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="20 6 9 17 4 12"></polyline>
                                    </svg>
                                }
                            </button>
                            <input type="hidden" name="CurrentPage" value="1" />
                        </form>
                    }
                </div>
            </div>
            <!-- End Dropdown -->
            <!-- Go To Page -->
            <div class="flex items-center gap-x-2">
                <span class="text-sm text-gray-800 whitespace-nowrap">
                    Go to
                </span>
                <form method="get" action="" class="inline">
                    @foreach (var qs in otherQueryStrings)
                    {
                        <input type="hidden" name="@qs.Key" value="@qs.Value" />
                    }
                    <input type="hidden" name="pageSize" value="@Model.PageSize" />
                    <input type="number" name="CurrentPage" class="min-h-[32px] py-1 px-2.5 block w-12 border-gray-200 rounded-lg text-sm text-center focus:border-blue-500 focus:ring-blue-500 [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none disabled:opacity-50 disabled:pointer-events-none"
                           min="1" max="@Model.TotalPage" value="@Model.CurrentPage" style="-moz-appearance: textfield;">
                    <button type="submit" class="hidden">Go</button>
                </form>
                <span class="text-sm text-gray-800 whitespace-nowrap">
                    page
                </span>
            </div>
            <!-- End Go To Page -->
        </div>
    </div>
    <span class="flex items-center justify-between text-sm">
        Total Record: <span class="font-semibold">@Model.TotalRecords</span>
    </span>
</div>
