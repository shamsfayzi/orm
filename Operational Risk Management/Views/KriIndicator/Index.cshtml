@model PaginatedModel<Template>

<div id="app" v-cloak>

    <!-- Header Section -->
    <div class="flex justify-between items-center mb-6">
        <div>
            <h1 class="text-2xl font-bold text-gray-800">Key Risk Indicators</h1>
            <p class="text-gray-600 mt-1">@Model.Items.First().Department.DepartmentName</p>
        </div>
        <div class="flex space-x-2">
            <button 
                    class="hs-dropdown-toggle py-2 px-3 inline-flex items-center gap-x-2 text-sm font-medium rounded-lg border border-gray-200 bg-white text-gray-800 shadow-sm hover:bg-gray-50">
                <svg class="flex-shrink-0 w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                </svg>
                Edit Template
            </button>
            <button 
                    class="py-2 px-3 inline-flex items-center gap-x-2 text-sm font-medium rounded-lg border border-gray-200 bg-white text-gray-800 shadow-sm hover:bg-gray-50">
                <svg class="flex-shrink-0 w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                </svg>
                Add Indicator
            </button>
            <a href="/KRI/Templates"
               class="py-2 px-3 inline-flex items-center gap-x-2 text-sm font-medium rounded-lg border border-gray-200 bg-white text-gray-800 shadow-sm hover:bg-gray-50">
                <svg class="flex-shrink-0 w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                Back to Templates
            </a>
        </div>
    </div>

    <!-- Template Info Card -->
    <div class="bg-white rounded-xl shadow-sm p-6 mb-6">
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
            <div>
                <h3 class="text-sm font-medium text-gray-500">Status</h3>
                @* <div class="mt-1 flex items-center"> *@
                @* <span v-bind:class="{ *@
                @*         'py-1 px-2 inline-flex items-center gap-x-1 text-xs font-medium rounded-full': true, *@
                @*         'bg-green-100 text-green-800': @ModeIsActive.ToString().ToLower(), *@
                @*         'bg-red-100 text-red-800': !@Model.IsActive.ToString().ToLower() *@
                @*     }"> *@
                @* @(Model.IsActive ? "Active" : "Inactive") *@
                @* </span> *@
                @* </div> *@
            </div>
            <div>
                <h3 class="text-sm font-medium text-gray-500">Department</h3>
                <p class="mt-1 text-sm text-gray-900">@Model.Items.First().Department.DepartmentName</p>
            </div>
            <div>
                <h3 class="text-sm font-medium text-gray-500">Focal Point</h3>
                <p class="mt-1 text-sm text-gray-900">@(Model.Items.First().FocalPoint ?? "Not assigned")</p>
            </div>
            <div>
                <h3 class="text-sm font-medium text-gray-500">Created</h3>
                <p class="mt-1 text-sm text-gray-900">@Html.DisplayFor(_ => Model.Items.First().CreateDate, "datetime_date_value")</p>
            </div>
        </div>
    </div>

    <!-- Indicators Section -->
    <div class="mb-6">
        <div class="flex justify-between items-center mb-4">
            <h2 class="text-lg font-semibold text-gray-800">Indicators</h2>
            <div class="flex items-center space-x-2">
                <div class="relative">
                    <input type="text"  placeholder="Search indicators..."
                           class="py-2 px-3 pe-9 block w-full border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500">
                    <div class="absolute inset-y-0 right-0 flex items-center pointer-events-none pe-3">
                        <svg class="h-4 w-4 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none"
                             viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tab Navigation -->
        <div class="mb-6 border-b border-gray-200 dark:border-gray-700">
            <nav class="flex flex-wrap gap-x-4 text-sm font-medium text-gray-500 dark:text-gray-400">
                <button type="button" @@click ="currentTab = 'indicators'" :class="[
        'hs-tab-active:border-b-2 hs-tab-active:border-blue-600 hs-tab-active:text-blue-600',
        'inline-flex items-center gap-x-2 py-3 px-4 border-b-2 border-transparent transition-all duration-300 hover:text-gray-700 hover:border-gray-300',
        currentTab === 'indicators' ? 'border-blue-600 text-blue-600' : ''
      ]">
                    <svg class="w-4 h-4 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                         stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    Indicators
                </button>

                <button type="button" @@click ="currentTab = 'submissions'" :class="[
        'hs-tab-active:border-b-2 hs-tab-active:border-blue-600 hs-tab-active:text-blue-600',
        'inline-flex items-center gap-x-2 py-3 px-4 border-b-2 border-transparent transition-all duration-300 hover:text-gray-700 hover:border-gray-300',
        currentTab === 'submissions' ? 'border-blue-600 text-blue-600' : ''
      ]">
                    <svg class="w-4 h-4 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                         stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                    </svg>
                    Monthly Submissions
                </button>

                <button type="button" @@click ="currentTab = 'analytics'" :class="[
        'hs-tab-active:border-b-2 hs-tab-active:border-blue-600 hs-tab-active:text-blue-600',
        'inline-flex items-center gap-x-2 py-3 px-4 border-b-2 border-transparent transition-all duration-300 hover:text-gray-700 hover:border-gray-300',
        currentTab === 'analytics' ? 'border-blue-600 text-blue-600' : ''
      ]">
                    <svg class="w-4 h-4 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                         stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                    </svg>
                    Analytics
                </button>
            </nav>
        </div>
        <div v-if="currentTab === 'submissions'">
            @await Html.PartialAsync("_IndicatorsTab", Model.Items)
        </div>

        <div v-if="currentTab === 'analytics'">
            @await Html.PartialAsync("_AnalyticsTab", Model.Items)
        </div>
        @await Html.PartialAsync("_Pagination", Model.Pagination)

    </div>
</div>

@section Scripts {
    <script>
        const app = Vue.createApp({
            data(){
                return {
                    currentTab:"indicators",

                }
            },
        });
        app.mount("#app")
    </script>
}